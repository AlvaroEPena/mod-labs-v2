---
/** "MOD LABS" drawn as rounded PCB traces (original letterforms, no font needed). Source: src/assets/brand/wordmark.svg. */
import wordmarkSvg from "../../assets/brand/wordmark.svg?raw";
import { inlineSvg } from "./svg";

interface Props {
  height?: number;
  class?: string;
  id?: string;
}
const { height = 18, class: cls, id = "wm" } = Astro.props;
const { viewBox, body } = inlineSvg(wordmarkSvg, id);
const [, , vbW = 196, vbH = 30] = viewBox.split(/\s+/).map(Number);
const width = Math.round((height * vbW) / vbH);
---

<svg {viewBox} {width} {height} class={cls} aria-hidden="true" focusable="false" set:html={body} />
