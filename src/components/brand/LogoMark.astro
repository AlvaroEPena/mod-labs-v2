---
/**
 * The Mod Labs monogram: a chip whose die is a lab flask, with a signal trace feeding it.
 * Source: src/assets/brand/mark.svg. Decorative unless `label` is set.
 */
import markSvg from "../../assets/brand/mark.svg?raw";
import { inlineSvg } from "./svg";

interface Props {
  size?: number;
  class?: string;
  id?: string;
  label?: string;
}
const { size = 36, class: cls, id = "mk", label } = Astro.props;
const { viewBox, body } = inlineSvg(markSvg, id);
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg {viewBox} width={size} height={size} class={cls} {...a11y} focusable="false" set:html={body} />
