---
/**
 * Masonry photo grid (CSS columns). Every tile is a real link to a 1600px WebP, so it works
 * without JS; with JS, src/scripts/lightbox.ts opens PhotoSwipe (loaded on first interaction).
 */
import { getImage } from "astro:assets";
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import type { Photo as PhotoRecord } from "../../data/gallery";

interface Props {
  photos: PhotoRecord[];
  /** gallery group name (one lightbox per group) */
  group: string;
  /** how many leading tiles load eagerly (the first project's first row is often above the fold on phones) */
  eager?: number;
}
const { photos, group, eager = 0 } = Astro.props;
/**
 * A tile is ~180 CSS px on phones and ~290 on desktop: 360/560 cover 1x-2.6x screens without shipping 800px files.
 * `sizes` subtracts the page gutters and column gap; plain 50vw overshoots 360w on common phones and pulls 560w.
 */
const TILE_WIDTHS = [360, 560];

const LIGHTBOX_EDGE = 1600;
const items = await Promise.all(
  photos.map(async (p) => {
    const scale = Math.min(1, LIGHTBOX_EDGE / Math.max(p.width, p.height));
    const width = Math.round(p.width * scale);
    const height = Math.round(p.height * scale);
    const large = await getImage({ src: p.image, width, height, format: "webp", quality: 72 });
    return { photo: p, href: large.src, width, height };
  }),
);
---

<ul class="masonry" data-pswp-gallery={group}>
  {
    items.map(({ photo, href, width, height }, i) => (
      <li class="masonry-item">
        <a href={href} class="gl-tile group" data-pswp-width={width} data-pswp-height={height} aria-label={`Open photo: ${photo.alt}`}>
          <Photo
            photo={photo}
            eager={i < eager}
            widths={TILE_WIDTHS}
            sizes="(min-width: 1280px) 290px, (min-width: 1024px) 23vw, (min-width: 640px) calc(33vw - 2rem), calc(50vw - 1.5rem)"
            class="gl-photo"
          />
          <span class="gl-zoom" aria-hidden="true">
            <Icon name="eye" size={18} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .masonry {
    columns: 2;
    column-gap: 0.6rem;
  }
  @media (width >= 40rem) {
    .masonry {
      columns: 3;
      column-gap: 0.9rem;
    }
  }
  @media (width >= 64rem) {
    .masonry {
      columns: 4;
    }
  }
  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.6rem;
  }
  @media (width >= 40rem) {
    .masonry-item {
      margin-bottom: 0.9rem;
    }
  }
  .gl-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-panel);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06);
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .gl-tile:active {
    transform: scale(0.985);
  }
  .gl-tile :global(.gl-photo img) {
    transition: transform 0.8s var(--ease-out-expo);
  }
  /* lit edge on hover/focus (opacity only) */
  .gl-tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgb(78 224 239 / 0.75),
      inset 0 0 36px rgb(78 224 239 / 0.22);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .gl-tile:hover::after,
  .gl-tile:focus-visible::after {
    opacity: 1;
  }
  .gl-zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--color-fg);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.03)),
      rgb(10 14 26 / 0.6);
    border: 1px solid rgb(255 255 255 / 0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease-out-expo);
  }
  .gl-tile:hover .gl-zoom,
  .gl-tile:focus-visible .gl-zoom {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gl-tile:hover :global(.gl-photo img) {
      transform: scale(1.05);
    }
  }
</style>
