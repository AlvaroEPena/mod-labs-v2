---
/**
 * Shared body of /gallery and /gallery/[category]: a sticky glass filter bar (real links, shareable URLs),
 * project chips, then one block per project (write-up + optional video row + masonry grid) and the lightbox.
 * Filtering is a page navigation smoothed by cross-document View Transitions: the filter bar stays put
 * (view-transition-name) and the lit pill glides from the old category to the new one (global.css enables
 * @view-transition only when motion is allowed). An inline script scrolls the active pill into view on
 * phones before first paint, so the glide never starts off-screen.
 */
import { getImage } from "astro:assets";
import "../../styles/lightbox.css";
import GalleryGrid from "./GalleryGrid.astro";
import Icon from "../ui/Icon.astro";
import { videoPoster } from "../media/picks";
import { categories, photosFor, photos, projects, projectsInCategory, videosFor, type CategorySlug } from "../../data/gallery";
import { builds } from "../../data/builds";

interface Props {
  category?: CategorySlug;
}
const { category } = Astro.props;

const visibleProjects = category ? projectsInCategory(category) : projects.filter((p) => photosFor(p.slug).length > 0);
const tabs = [
  { href: "/gallery", label: "All", count: photos.length, active: !category },
  ...categories.map((c) => ({
    href: `/gallery/${c.slug}`,
    label: c.short,
    count: photos.filter((p) => p.category === c.slug).length,
    active: c.slug === category,
  })),
];
const catTitle = (slug: CategorySlug) => categories.find((c) => c.slug === slug)?.short ?? slug;
/** Poster URL per video src (build-time WebP, 720px is plenty for a ~18rem card). */
const posters = new Map(
  await Promise.all(
    visibleProjects.flatMap((p) =>
      videosFor(p.slug).map(async (v) => {
        const { image } = videoPoster(p.slug, v.posterId);
        return [v.src, (await getImage({ src: image, width: 720, format: "webp", quality: 70 })).src] as const;
      }),
    ),
  ),
);
---

<nav class="filter-wrap" aria-label="Gallery categories">
  <div class="container-x">
    <ul class="tabs glass" data-gallery-tabs>
      {
        tabs.map((t) => (
          <li>
            <a href={t.href} class:list={["tab", t.active && "is-active"]} aria-current={t.active ? "page" : undefined}>
              {t.active && <span class="tab-pill" aria-hidden="true" />}
              <span class="tab-label">{t.label}</span>
              <span class="tab-count mono">{t.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <script is:inline>
      // centre the active category pill in the (phone-width) scroller before first paint
      (function () {
        const list = document.querySelector("[data-gallery-tabs]");
        const active = list && list.querySelector(".is-active");
        if (list && active) list.scrollLeft = active.offsetLeft - (list.clientWidth - active.offsetWidth) / 2;
      })();
    </script>
  </div>
</nav>

<div class="container-x pt-8 pb-10 sm:pt-12 sm:pb-14">
  {
    visibleProjects.length > 1 && (
      <nav aria-label="Jump to a project" class="mb-12 sm:mb-16">
        <ul class="jumps">
          {visibleProjects.map((p) => (
            <li>
              <a href={`#${p.slug}`} class="jump">
                {p.title}
                <span class="mono text-dim">{photosFor(p.slug).length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="grid gap-16 sm:gap-24">
    {
      visibleProjects.map((p, pi) => {
        const list = photosFor(p.slug);
        const projectVideos = videosFor(p.slug);
        const build = p.build ? builds.find((b) => b.slug === p.build) : undefined;
        return (
          <section
            id={p.slug}
            class="project scroll-mt-36"
            aria-labelledby={`${p.slug}-title`}
            style={`--rows-2:${Math.ceil(list.length / 2)};--rows-3:${Math.ceil(list.length / 3)};--rows-4:${Math.ceil(list.length / 4)};--videos:${projectVideos.length ? 1 : 0}`}
          >
            <header class={pi === 0 ? "project-head" : "project-head reveal"}>
              <div class="max-w-3xl">
                <h2 id={`${p.slug}-title`} class="text-2xl sm:text-[2rem]">
                  {p.title}
                </h2>
                <p class="mono mt-2 text-sm text-dim">
                  {catTitle(p.category)} · {list.length} {list.length === 1 ? "photo" : "photos"}
                </p>
                <p class="mt-4 leading-relaxed text-muted">{p.caption}</p>
              </div>
              {build && (
                <div class="flex flex-wrap gap-2.5">
                  <a href={`/quote?build=${build.slug}`} class="btn btn-primary btn-sm">
                    Request this build<span class="sr-only">: {build.name}</span>
                  </a>
                  <a href={`/builds#${build.slug}`} class="btn btn-ghost btn-sm">
                    Build details<span class="sr-only">: {build.name}</span>
                    <Icon name="arrow" size={16} />
                  </a>
                </div>
              )}
            </header>
            {projectVideos.length ? (
              <ul class="video-row" aria-label={`${p.title} videos`}>
                {projectVideos.map((v) => (
                  <li class="video-item">
                    <figure class="video-card reveal">
                      <video
                        class="video"
                        controls
                        preload="none"
                        playsinline
                        poster={posters.get(v.src)}
                        width="1080"
                        height="1920"
                        aria-label={v.title}
                      >
                        <source src={v.src} type="video/mp4" />
                        <a href={v.src}>Download the video</a>
                      </video>
                      <figcaption class="flex items-center gap-2.5 px-4 py-3 text-sm text-muted">
                        <span class="play-pad" aria-hidden="true">
                          <Icon name="play" size={12} />
                        </span>
                        {v.title}
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            ) : null}
            <GalleryGrid photos={list} group={p.slug} eager={pi === 0 ? 2 : 0} />
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import "../../scripts/lightbox";
</script>

<style>
  /*
   * Skip layout/paint for off-screen projects until they scroll near (big win on phones). The placeholder
   * height is estimated from the photo rows (--rows-N set per section) so long projects don't overflow it
   * (that made tiles report overlapping boxes and the scrollbar jump); `auto` then remembers the real size.
   * The first project's header skips the reveal: it is the LCP element on phones and should paint at once.
   */
  .project + .project {
    content-visibility: auto;
    contain-intrinsic-block-size: auto calc(var(--rows-2, 6) * 16rem + 16rem + var(--videos, 0) * 34rem);
    min-width: 0;
  }
  @media (width >= 40rem) {
    .project + .project {
      contain-intrinsic-block-size: auto calc(var(--rows-3, 4) * 16rem + 16rem + var(--videos, 0) * 34rem);
    }
  }
  @media (width >= 64rem) {
    .project + .project {
      contain-intrinsic-block-size: auto calc(var(--rows-4, 3) * 22rem + 16rem + var(--videos, 0) * 34rem);
    }
  }

  /* --- filter bar: a floating glass pill under the header --- */
  .filter-wrap {
    position: sticky;
    top: calc(var(--header-h) + 0.25rem);
    z-index: 30;
  }
  /* named here, not on the sticky wrapper: a named element is a backdrop root, which would blank the blur */
  .tabs {
    position: relative;
    view-transition-name: gallery-tabs;
    display: flex;
    gap: 0.25rem;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.35rem;
    border-radius: 999px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .tab:hover,
  .tab.is-active {
    color: var(--color-fg);
  }
  .tab:focus-visible {
    outline-offset: -2px;
    border-radius: 999px;
  }
  .tab-label,
  .tab-count {
    position: relative;
  }
  .tab-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-dim);
  }
  .tab.is-active .tab-count {
    color: var(--color-cyan-soft);
  }
  /* the lit pill behind the active tab: one named element per page, so it morphs between pages */
  .tab-pill {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(78 224 239 / 0.24), rgb(78 224 239 / 0.1));
    border: 1px solid rgb(78 224 239 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 8px 24px -10px rgb(78 224 239 / 0.6);
    view-transition-name: gallery-pill;
  }

  /* --- project chips: one swipeable row on phones, wrapping from sm --- */
  .jumps {
    display: flex;
    gap: 0.5rem;
    margin-inline: -1.125rem;
    padding-inline: 1.125rem;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .jumps::-webkit-scrollbar {
    display: none;
  }
  @media (width >= 40rem) {
    .jumps {
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
  .jump {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    white-space: nowrap;
    scroll-snap-align: start;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    background: rgb(255 255 255 / 0.035);
    border: 1px solid var(--color-line-soft);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .jump:hover {
    color: var(--color-fg);
    border-color: rgb(78 224 239 / 0.5);
  }
  .jump .mono {
    font-size: 0.75rem;
  }

  /* --- project header: copy, with the build CTAs beside it from lg --- */
  .project-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }
  @media (width >= 64rem) {
    .project-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  /* --- videos: their own row above the photos so the grid keeps its column count --- */
  .video-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  @media (width >= 40rem) {
    .video-row {
      justify-content: flex-start;
    }
  }
  .video-item {
    flex: 0 1 18rem;
    min-width: 0;
  }
  .video-card {
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-panel);
    border: 1px solid rgb(78 224 239 / 0.3);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 30px 60px -40px rgb(78 224 239 / 0.45);
  }
  .video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    max-height: 75vh;
    object-fit: cover;
    background: #05070e;
  }
  .play-pad {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    color: #04131a;
    background: var(--color-cyan);
  }
</style>
