---
/**
 * Shared body of /gallery and /gallery/[category]: filter tabs (real links, shareable URLs),
 * one block per project (write-up + masonry grid + optional video) and the lightbox script.
 */
import { getImage } from "astro:assets";
import GalleryGrid from "./GalleryGrid.astro";
import Icon from "../ui/Icon.astro";
import { videoPoster } from "../media/picks";
import { categories, photosFor, photos, projects, projectsInCategory, type CategorySlug } from "../../data/gallery";
import { builds } from "../../data/builds";

interface Props {
  category?: CategorySlug;
}
const { category } = Astro.props;

const visibleProjects = category ? projectsInCategory(category) : projects.filter((p) => photosFor(p.slug).length > 0);
const tabs = [
  { href: "/gallery", label: "All", count: photos.length, active: !category },
  ...categories.map((c) => ({
    href: `/gallery/${c.slug}`,
    label: c.short,
    count: photos.filter((p) => p.category === c.slug).length,
    active: c.slug === category,
  })),
];
const catTitle = (slug: CategorySlug) => categories.find((c) => c.slug === slug)?.short ?? slug;
const posterFor = async (slug: string) => {
  const src = videoPoster(slug);
  return (await getImage({ src: src.image, width: 720, format: "webp", quality: 70 })).src;
};
const posters = Object.fromEntries(
  await Promise.all(visibleProjects.filter((p) => p.video).map(async (p) => [p.slug, await posterFor(p.slug)] as const)),
);
---

<nav class="tabs-wrap" aria-label="Gallery categories">
  <div class="container-x">
    <ul class="tabs">
      {
        tabs.map((t) => (
          <li>
            <a href={t.href} class:list={["tab", t.active && "is-active"]} aria-current={t.active ? "page" : undefined}>
              {t.label}
              <span class="tab-count">{t.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<div class="container-x py-10 sm:py-14">
  {
    visibleProjects.length > 1 && (
      <nav aria-label="Jump to a project" class="mb-12">
        <ul class="flex flex-wrap gap-2">
          {visibleProjects.map((p) => (
            <li>
              <a href={`#${p.slug}`} class="jump">
                {p.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="grid gap-16 sm:gap-20">
    {
      visibleProjects.map((p) => {
        const list = photosFor(p.slug);
        const build = p.build ? builds.find((b) => b.slug === p.build) : undefined;
        const poster = posters[p.slug];
        return (
          <section id={p.slug} class="project scroll-mt-28" aria-labelledby={`${p.slug}-title`}>
            <div class="reveal mb-7 grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
              <div class="max-w-3xl">
                <p class="eyebrow mb-3">
                  {catTitle(p.category)} · {list.length} {list.length === 1 ? "photo" : "photos"}
                </p>
                <h2 id={`${p.slug}-title`} class="text-2xl sm:text-3xl">
                  {p.title}
                </h2>
                <p class="mt-3 leading-relaxed text-muted">{p.caption}</p>
              </div>
              {build && (
                <div class="flex flex-wrap gap-3">
                  <a href={`/builds#${build.slug}`} class="btn btn-ghost btn-sm">
                    Build details
                  </a>
                  <a href={`/quote?build=${build.slug}`} class="btn btn-primary btn-sm">
                    Request this build · ${build.price}
                  </a>
                </div>
              )}
            </div>
            {p.video ? (
              <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-6">
                <figure class="video-card reveal min-w-0 justify-self-center w-full max-w-sm lg:max-w-none">
                  <video
                    class="video"
                    controls
                    preload="none"
                    playsinline
                    poster={poster}
                    width="1080"
                    height="1920"
                    aria-label={p.video.title}
                  >
                    <source src={p.video.src} type="video/mp4" />
                    <a href={p.video.src}>Download the video</a>
                  </video>
                  <figcaption class="flex items-center gap-2 px-4 py-3 text-sm text-muted">
                    <Icon name="play" size={14} class="text-magenta" /> {p.video.title}
                  </figcaption>
                </figure>
                <GalleryGrid photos={list} group={p.slug} compact />
              </div>
            ) : (
              <GalleryGrid photos={list} group={p.slug} />
            )}
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import "../../scripts/lightbox";
</script>

<style>
  /* skip layout/paint for off-screen projects until they scroll near (big win on phones) */
  .project + .project {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 1400px;
    min-width: 0;
  }
  .tabs-wrap {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background: rgb(7 8 21 / 0.94);
    border-bottom: 1px solid var(--color-line-soft);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .tabs {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-block: 0.7rem;
    margin-inline: -1rem;
    padding-inline: 1rem;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    white-space: nowrap;
    scroll-snap-align: start;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    border: 1px solid var(--color-line);
    background: rgb(15 18 48 / 0.6);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .tab:hover {
    color: var(--color-fg);
    border-color: #3a4390;
  }
  .tab.is-active {
    color: var(--color-ink);
    background: var(--color-cyan);
    border-color: var(--color-cyan);
    box-shadow: 0 0 20px -4px rgb(0 229 255 / 0.7);
  }
  .tab-count {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
  }
  .tab.is-active .tab-count {
    background: rgb(7 8 21 / 0.18);
  }
  .jump {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-radius: 0.7rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    border: 1px dashed var(--color-line);
  }
  .jump:hover {
    color: var(--color-cyan);
    border-color: rgb(0 229 255 / 0.6);
  }
  .video-card {
    align-self: start;
    overflow: hidden;
    border-radius: 1.1rem;
    background: var(--color-panel);
    border: 1px solid rgb(255 61 242 / 0.35);
    box-shadow: 0 0 40px -12px rgb(255 61 242 / 0.45);
  }
  .video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    max-height: 75vh;
    object-fit: cover;
    background: #000;
  }
</style>
