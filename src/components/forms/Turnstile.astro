---
/**
 * Cloudflare Turnstile slot. The script is NOT loaded with the page: the form controller loads it and
 * renders the widget on the visitor's first interaction with the form (src/scripts/forms/turnstile.ts),
 * so people who only browse never run the challenge or get an unverified token.
 */
interface Props {
  action: string;
}
const { action } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

{
  siteKey ? (
    <div class="ts">
      <div data-turnstile data-sitekey={siteKey} data-action={action} />
      <p class="field-error" data-error-for="cf-turnstile-response" />
    </div>
  ) : (
    <p class="text-sm text-dim">Spam check isn't configured (PUBLIC_TURNSTILE_SITE_KEY missing).</p>
  )
}

<style>
  .ts {
    /* reserve the widget's height so nothing jumps when it appears */
    min-height: 65px;
  }
</style>
