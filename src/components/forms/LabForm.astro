---
/**
 * Request form fields shared by /book and /quote (name, email, phone, delivery, message, consent) inside
 * FormShell. Field names and order come from `fieldNames` in the shared contract (src/lib/forms/schema.ts);
 * `top` holds the service/request picker, `extra` the quote photos.
 */
import FormShell from "./FormShell.astro";
import { deliveryOptions, fieldNames as F, PHOTO_MAX_BYTES, PHOTO_MAX_FILES } from "../../lib/forms/schema";
import { requestCopy } from "../../scripts/forms/messages";

interface Props {
  kind: "book" | "quote";
  submitLabel: string;
  /** extra data-* for the controller (JSON maps, etc.) */
  data?: Record<string, string>;
  messagePlaceholder?: string;
}
const { kind, submitLabel, data = {}, messagePlaceholder } = Astro.props;
const id = kind;
const deliveryHints: Record<string, string> = {
  [deliveryOptions[0]]: "Fast turnaround, usually same or next day.",
  [deliveryOptions[1]]: "We'll sort out shipping and timing before you send anything.",
};
const e = (name: string) => `${id}-${name}-error`;
const MESSAGE_MAX = 2000;
---

<FormShell
  kind={kind}
  action={`/api/${kind}`}
  submitLabel={submitLabel}
  honeypot={F.honeypot}
  data={{ "max-files": PHOTO_MAX_FILES, "max-bytes": PHOTO_MAX_BYTES, ...data }}
  success={{
    title: "Request sent!",
    message: requestCopy.success,
    next: ["Check your inbox (and spam folder) for my reply", "I'll confirm the price and timing with you", "Nothing happens until you say go"],
    again: "Send another request",
    link: { href: "/gallery", label: "Browse the gallery" },
  }}
>
  <slot name="top" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class="field-label" for={`${id}-name`}>Your name</label>
      <input class="input" id={`${id}-name`} name={F.name} type="text" autocomplete="name" required minlength="2" maxlength="80" aria-describedby={e("name")} />
      <p class="field-error" id={e("name")} data-error-for={F.name}></p>
    </div>
    <div>
      <label class="field-label" for={`${id}-email`}>Email</label>
      <input
        class="input"
        id={`${id}-email`}
        name={F.email}
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        maxlength="254"
        aria-describedby={e("email")}
      />
      <p class="field-error" id={e("email")} data-error-for={F.email}></p>
    </div>
    <div class="sm:col-span-2">
      <label class="field-label" for={`${id}-phone`}>Phone <span class="optional">optional</span></label>
      <input
        class="input sm:max-w-xs"
        id={`${id}-phone`}
        name={F.phone}
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        maxlength="30"
        aria-describedby={`${id}-phone-hint ${e("phone")}`}
      />
      <p class="field-hint mt-1.5" id={`${id}-phone-hint`}>If you'd rather text. I'll reply by email either way.</p>
      <p class="field-error" id={e("phone")} data-error-for={F.phone}></p>
    </div>
  </div>

  <fieldset class="grid gap-3" aria-describedby={e("delivery")}>
    <legend class="field-label">How will you get it to me?</legend>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        deliveryOptions.map((opt, i) => (
          <label class="tile items-start">
            <input type="radio" class="check mt-0.5" name={F.delivery} value={opt} required checked={i === 0} />
            <span>
              <span class="block font-semibold text-fg">{opt}</span>
              <span class="mt-0.5 block text-sm leading-snug text-muted">{deliveryHints[opt]}</span>
            </span>
          </label>
        ))
      }
    </div>
    <p class="field-error" id={e("delivery")} data-error-for={F.delivery}></p>
  </fieldset>

  <div>
    <div class="flex items-baseline justify-between gap-3">
      <label class="field-label" for={`${id}-message`}>Message</label>
      <span class="field-hint mono" aria-hidden="true"><span data-count-for={`${id}-message`}>0</span> / {MESSAGE_MAX}</span>
    </div>
    <textarea
      class="input"
      id={`${id}-message`}
      name={F.message}
      required
      minlength="20"
      maxlength={MESSAGE_MAX}
      rows="6"
      placeholder={messagePlaceholder}
      aria-describedby={`${id}-message-hint ${e("message")}`}></textarea>
    <p class="field-hint mt-1.5" id={`${id}-message-hint`}><slot name="message-hint">At least 20 characters.</slot></p>
    <p class="field-error" id={e("message")} data-error-for={F.message}></p>
  </div>

  <slot name="extra" />

  <div>
    <label class="tile items-start">
      <input type="checkbox" class="check mt-0.5" name={F.consent} value="yes" required aria-describedby={e("consent")} />
      <span class="text-sm leading-relaxed text-muted">
        It's OK to contact me about this request by email (or phone, if I gave one). See the <a
          href="/privacy"
          class="text-cyan underline underline-offset-2">privacy policy</a
        >.
      </span>
    </label>
    <p class="field-error" id={e("consent")} data-error-for={F.consent}></p>
  </div>
</FormShell>
