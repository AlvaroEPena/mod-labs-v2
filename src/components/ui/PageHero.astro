---
/**
 * Inner-page hero. Copy (H1, optional gradient-lit phrase, intro, actions slot) on the left; an optional
 * `aside` slot holds the page's own visual (price board, product cards, photo stack...) at the right
 * from lg, below the copy on phones. Without an aside, a small circuit "bloom" powers on in the corner.
 * No eyebrow by default: the H1 carries the page (eyebrow budget, spec §16).
 */
interface Props {
  title: string;
  /** words inside the title lit with the cyan sweep */
  highlight?: string;
  intro?: string;
  /** shorter hero for task pages (forms, legal, FAQ) */
  compact?: boolean;
}
const { title, highlight, intro, compact = false } = Astro.props;
const parts = highlight && title.includes(highlight) ? title.split(highlight) : null;
const hasAside = Astro.slots.has("aside");
---

<section class:list={["page-hero ambient", compact && "is-compact", hasAside && "has-aside"]} aria-labelledby="page-title">
  {
    !hasAside && (
      <svg class="ph-bloom" viewBox="0 0 420 240" aria-hidden="true" focusable="false">
        <g fill="none" stroke="#4ee0ef" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M420 52H300L270 82H190" pathLength="1" />
          <path d="M420 126H330L304 152H236" pathLength="1" />
          <path d="M420 196H352L322 166" pathLength="1" />
        </g>
        <g fill="#05070e" stroke="#a9f2fa" stroke-width="1.6">
          <circle cx="190" cy="82" r="4.5" />
          <circle cx="236" cy="152" r="4.5" />
          <circle cx="322" cy="166" r="4.5" />
        </g>
      </svg>
    )
  }
  <div class="container-x ph-grid">
    <div class="ph-copy min-w-0">
      <h1 id="page-title" class="ph-title ph-in">
        {
          parts ? (
            <>
              {parts[0]}
              <span class="text-gradient">{highlight}</span>
              {parts[1]}
            </>
          ) : (
            title
          )
        }
      </h1>
      {intro && <p class="lead ph-in ph-intro" style="--o:1">{intro}</p>}
      <div class="ph-in" style="--o:2"><slot /></div>
    </div>
    {
      hasAside && (
        <div class="ph-aside ph-in min-w-0" style="--o:2">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    --ax: 14%;
    --ay: 30%;
    overflow-x: clip;
  }
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.75rem;
    align-items: center;
    padding-top: 2.75rem;
    padding-bottom: 3.5rem;
  }
  .is-compact .ph-grid {
    padding-top: 2.25rem;
    padding-bottom: 2rem;
  }
  @media (width >= 64rem) {
    .ph-grid {
      padding-top: 4.5rem;
      padding-bottom: 5rem;
    }
    .has-aside .ph-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 4rem;
      padding-top: 3.5rem;
    }
    .is-compact .ph-grid {
      padding-top: 3.75rem;
      padding-bottom: 2.75rem;
    }
  }

  .ph-title {
    max-width: 18ch;
    font-size: clamp(2.45rem, 1.45rem + 3.6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.042em;
  }
  .is-compact .ph-title {
    max-width: 20ch;
    font-size: clamp(2.25rem, 1.55rem + 2.6vw, 3.5rem);
  }
  .ph-intro {
    margin-top: 1.25rem;
    max-width: 36rem;
  }

  /* corner bloom: three traces running in from the right edge to vias */
  .ph-bloom {
    position: absolute;
    top: 0.5rem;
    right: 0;
    width: min(26rem, 70vw);
    height: auto;
    opacity: 0.5;
    pointer-events: none;
    mask-image: linear-gradient(270deg, #000 30%, transparent);
  }
  @media (width < 48rem) {
    .ph-bloom {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ph-in {
      animation: ph-in 0.85s var(--ease-out-expo) both;
      animation-delay: calc(0.04s + var(--o, 0) * 0.08s);
    }
    .ph-bloom path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: ph-draw 1.3s var(--ease-snap) 0.2s forwards;
    }
    .ph-bloom path:nth-child(2) {
      animation-delay: 0.35s;
    }
    .ph-bloom path:nth-child(3) {
      animation-delay: 0.5s;
    }
    .ph-bloom circle {
      opacity: 0;
      animation: ph-on 0.4s ease 1.1s forwards;
    }
  }
  @keyframes ph-in {
    from {
      opacity: 0.01; /* >0 keeps the H1 eligible as LCP from the first paint */
      transform: translateY(16px);
    }
  }
  @keyframes ph-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ph-on {
    to {
      opacity: 1;
    }
  }
</style>
