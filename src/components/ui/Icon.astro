---
/** Phosphor icon (256×256 viewBox, currentColor fill). Decorative by default; pass `label` to expose it. */
import { iconBody, type IconName } from "./icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: cls, label } = Astro.props;
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg viewBox="0 0 256 256" width={size} height={size} class={cls} fill="currentColor" focusable="false" {...a11y} set:html={iconBody(name)} />
