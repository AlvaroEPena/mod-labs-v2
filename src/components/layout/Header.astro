---
import Logo from "../brand/Logo.astro";
import Icon from "../ui/Icon.astro";
import { mainNav, isCurrent } from "./nav";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container-x">
    <div class="nav-shell glass">
      <a href="/" class="flex min-h-11 items-center rounded-full px-1" aria-label="Mod Labs home">
        <Logo id="hdr" size="md" />
      </a>

      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-0.5">
          {
            mainNav.map((l) => (
              <li>
                <a href={l.href} class="nav-link" aria-current={isCurrent(path, l.href) ? "page" : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href="/quote" class="btn btn-ghost btn-sm hidden lg:inline-flex">Get a quote</a>
        <a href="/book" class="btn btn-primary btn-sm hidden md:inline-flex">Book a service</a>
        <button type="button" class="burger grid lg:hidden" popovertarget="mobile-menu" aria-label="Menu" aria-controls="mobile-menu">
          <span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu" popover class="mobile-menu glass">
  <nav aria-label="Mobile" class="p-3 pb-5">
    <ul class="grid gap-0.5">
      {
        mainNav.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} class="mm-link" aria-current={isCurrent(path, l.href) ? "page" : undefined}>
              <span>{l.label}</span>
              <Icon name="arrow" size={18} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-4 grid grid-cols-2 gap-2.5 px-1">
      <a href="/quote" class="btn btn-ghost">Get a quote</a>
      <a href="/book" class="btn btn-primary">Book a service</a>
    </div>
    <p class="mt-4 flex items-center gap-2 px-2 text-sm text-dim">
      <Icon name="pin" size={16} class="text-cyan" /> Seattle drop-off, mail-in welcome
    </p>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 0.75rem;
    height: var(--header-h);
    view-transition-name: site-header;
  }
  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.5rem;
    padding: 0 0.5rem 0 1rem;
    border-radius: 999px;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.925rem;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav-link:hover {
    color: var(--color-fg);
    background: rgb(255 255 255 / 0.06);
  }
  .nav-link[aria-current="page"] {
    color: var(--color-fg);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  .burger {
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.05);
    color: var(--color-fg);
    cursor: pointer;
  }
  .burger-lines {
    position: relative;
    display: block;
    width: 1.1rem;
    height: 0.8rem;
  }
  .burger-lines span {
    position: absolute;
    left: 0;
    height: 1.5px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.3s var(--ease-out-expo),
      opacity 0.2s;
  }
  .burger-lines span:nth-child(1) {
    top: 0;
  }
  .burger-lines span:nth-child(2) {
    top: calc(50% - 0.75px);
    width: 65%;
  }
  .burger-lines span:nth-child(3) {
    bottom: 0;
  }
  :global(body:has(#mobile-menu:popover-open)) .burger-lines span:nth-child(1) {
    transform: translateY(calc(0.4rem - 0.75px)) rotate(45deg);
  }
  :global(body:has(#mobile-menu:popover-open)) .burger-lines span:nth-child(2) {
    opacity: 0;
  }
  :global(body:has(#mobile-menu:popover-open)) .burger-lines span:nth-child(3) {
    transform: translateY(calc(-0.4rem + 0.75px)) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: calc(var(--header-h) + 0.5rem) 1.125rem auto 1.125rem;
    width: auto;
    max-width: 30rem;
    max-height: calc(100dvh - var(--header-h) - 1.5rem);
    overflow-y: auto;
    margin: 0 0 0 auto;
    padding: 0;
    border-radius: 1.5rem;
    color: var(--color-fg);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02) 60%),
      rgb(10 14 26 / 0.86);
  }
  .mobile-menu::backdrop {
    background: rgb(3 4 10 / 0.5);
  }
  .mm-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    padding: 0 0.9rem;
    border-radius: 1rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: var(--color-fg);
  }
  .mm-link svg {
    color: var(--color-dim);
    transition: color 0.2s;
  }
  .mm-link:hover,
  .mm-link[aria-current="page"] {
    background: rgb(255 255 255 / 0.06);
  }
  .mm-link:hover svg,
  .mm-link[aria-current="page"] svg {
    color: var(--color-cyan);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu {
      transition:
        opacity 0.25s ease,
        transform 0.4s var(--ease-out-expo),
        overlay 0.4s allow-discrete,
        display 0.4s allow-discrete;
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
      transform-origin: top right;
    }
    .mobile-menu:popover-open {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .mobile-menu:popover-open {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
      }
    }
    .mobile-menu:popover-open li {
      animation: mm-in 0.45s var(--ease-out-expo) both;
      animation-delay: calc(0.05s + var(--i) * 0.035s);
    }
  }
  @keyframes mm-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script>
  // Popover handles open/close, Esc and light-dismiss natively. We just move focus in and close on navigation.
  const menu = document.getElementById("mobile-menu");
  menu?.addEventListener("toggle", (e) => {
    if ((e as ToggleEvent).newState === "open") menu.querySelector<HTMLElement>("a")?.focus();
  });
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) menu.hidePopover();
  });
  matchMedia("(min-width: 64rem)").addEventListener("change", (m) => {
    if (m.matches && menu?.matches(":popover-open")) menu.hidePopover();
  });
</script>
