---
import Icon from "../ui/Icon.astro";
---

<div class="cta-bar grid md:hidden" role="region" aria-label="Quick actions">
  <a href="/quote" class="btn btn-ghost"><Icon name="chat" size={18} /> Get a quote</a>
  <a href="/book" class="btn btn-primary"><Icon name="bolt" size={18} /> Book</a>
</div>

<style>
  /* floating glass pill above the home indicator */
  .cta-bar {
    position: fixed;
    inset: auto 0.75rem calc(0.75rem + env(safe-area-inset-bottom)) 0.75rem;
    z-index: 40;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.45rem;
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02)),
      rgb(10 14 26 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 20px 50px -20px rgb(0 0 0 / 0.9);
    backdrop-filter: var(--glass-frost);
    -webkit-backdrop-filter: var(--glass-frost);
    view-transition-name: cta-bar;
  }
  .cta-bar .btn {
    min-height: 3rem;
  }
  @media (prefers-reduced-transparency: reduce) {
    .cta-bar {
      background: var(--color-panel-2); /* the frost token is already `none` here */
    }
  }
  /* reserve room so the bar never covers content or the footer */
  @media (width < 48rem) {
    :global(body.has-cta-bar) {
      --cta-bar-h: calc(5rem + env(safe-area-inset-bottom));
    }
  }
</style>
