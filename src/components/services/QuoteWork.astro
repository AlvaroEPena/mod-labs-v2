---
/**
 * Quote-priced work as a 3-cell bento (one cell per item, no empty cells): repair (tall, with a bench
 * photo), custom shells & RGB, and a pointer to the commission builds with their two cover photos.
 * The "what's included" lists are the exact ones from services.ts.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import { buildCover, categoryCover } from "../media/picks";
import { quoteServices } from "../../data/services";
import { builds } from "../../data/builds";

const repair = quoteServices.find((s) => s.id === "repair")!;
const shell = quoteServices.find((s) => s.id === "custom-shell")!;
const cheapestBuild = Math.min(...builds.map((b) => b.price));
---

<section id="by-quote" class="section-y scroll-mt-24" aria-labelledby="by-quote-title">
  <div class="container-x">
    <h2 id="by-quote-title" class="reveal max-w-2xl text-4xl sm:text-5xl">Repairs and custom work, by quote.</h2>
    <p class="lead reveal mt-5 max-w-xl">
      Every job here is a little different. Send a few photos and I'll reply with a clear price and timeline before any work starts.
    </p>

    <div class="bento reveal-stagger mt-12 grid gap-4 lg:grid-cols-12">
      <article id={repair.id} class="cell-repair card glow-edge lg:col-span-7 lg:row-span-2">
        <Photo photo={categoryCover("repairs")} ratio="16 / 9" sizes="(min-width: 1024px) 700px, 100vw" widths={[480, 800, 1200]} class="repair-photo" />
        <div class="p-6 sm:p-8">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-2xl sm:text-3xl">{repair.name}</h3>
            <span class="quote-chip">By quote</span>
          </div>
          <p class="mt-3 leading-relaxed text-muted">{repair.summary}</p>
          <ul class="solder-list mt-5">
            {repair.includes.map((i) => <li>{i}</li>)}
          </ul>
          <a href="/quote" class="btn btn-primary mt-8 w-full sm:w-auto">
            Get a quote<span class="sr-only">: {repair.name}</span>
            <Icon name="arrow" size={18} />
          </a>
        </div>
      </article>

      <article id={shell.id} class="cell-shell card glow-edge p-6 sm:p-8 lg:col-span-5">
        <div class="flex items-center justify-between gap-4">
          <span class="icon-pad" aria-hidden="true"><Icon name="sparkle" size={22} /></span>
          <span class="quote-chip">By quote</span>
        </div>
        <h3 class="mt-5 text-2xl">{shell.name}</h3>
        <p class="mt-2 leading-relaxed text-muted">{shell.summary}</p>
        <ul class="solder-list mt-5">
          {shell.includes.map((i) => <li>{i}</li>)}
        </ul>
        <a href="/quote" class="btn btn-ghost mt-7 w-full sm:w-auto">
          Get a quote<span class="sr-only">: {shell.name}</span>
        </a>
      </article>

      <a href="/builds" class="cell-builds card glow-edge lg:col-span-5">
        <span class="builds-thumbs" aria-hidden="true">
          {builds.map((b) => <Photo photo={buildCover(b.slug)} ratio="1 / 1" sizes="96px" widths={[200]} class="builds-thumb" alt="" />)}
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-xl font-semibold text-fg">Want a whole console built?</span>
          <span class="mt-1 block leading-relaxed text-muted">
            Hand-built Wii commissions from <span class="mono text-fg">${cheapestBuild}</span>.
          </span>
        </span>
        <span class="go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .cell-repair {
    overflow: hidden;
  }
  .cell-repair :global(.repair-photo) {
    border-bottom: 1px solid var(--color-line-soft);
  }
  .cell-shell {
    background:
      radial-gradient(26rem 16rem at 100% 0%, rgb(139 124 246 / 0.16), transparent 70%),
      radial-gradient(20rem 14rem at 0% 100%, rgb(78 224 239 / 0.08), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.055), rgb(255 255 255 / 0.015) 60%),
      rgb(12 17 31 / 0.64);
  }
  .quote-chip {
    flex: none;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-cyan-soft);
    background: rgb(78 224 239 / 0.06);
    border: 1px dashed rgb(78 224 239 / 0.4);
  }
  .cell-builds {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.25rem 1.4rem;
    text-decoration: none;
  }
  @media (width >= 40rem) {
    .cell-builds {
      padding: 1.6rem 1.75rem;
    }
  }
  .builds-thumbs {
    display: flex;
    flex: none;
  }
  .builds-thumbs :global(.builds-thumb) {
    width: 3rem;
    border-radius: 1rem;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 0 0 3px var(--color-panel);
  }
  .builds-thumbs :global(.builds-thumb + .builds-thumb) {
    margin-left: -0.9rem;
    transform: rotate(6deg);
  }
  .go {
    display: none;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-cyan);
    background: rgb(78 224 239 / 0.08);
    border: 1px solid rgb(78 224 239 / 0.25);
    transition: transform 0.35s var(--ease-out-expo);
  }
  @media (width >= 40rem) {
    .go {
      display: grid;
    }
    .builds-thumbs :global(.builds-thumb) {
      width: 3.75rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cell-builds:hover .go {
      transform: translateX(3px);
    }
  }
</style>
