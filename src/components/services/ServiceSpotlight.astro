---
/**
 * One priced service as a feature: a big photo with a frosted-glass spec panel docked over its edge
 * (overlapping it from lg; tucked under the photo on phones). Price, summary and the exact
 * "what's included" list come from services.ts.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import type { Service } from "../../data/services";
import type { Photo as PhotoRecord } from "../../data/gallery";

interface Props {
  service: Service;
  photo: PhotoRecord;
}
const { service, photo } = Astro.props;
---

<section id={service.id} class="spot section-y scroll-mt-24" aria-labelledby={`${service.id}-title`}>
  <div class="container-x spot-grid">
    <div class="spot-media reveal">
      <Photo photo={photo} ratio="4 / 3" sizes="(min-width: 1024px) 760px, 100vw" widths={[480, 800, 1200]} class="spot-photo" />
    </div>
    <div class="spot-panel glass reveal">
      <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-2">
        <h2 id={`${service.id}-title`} class="text-[1.8rem] sm:text-4xl">{service.name}</h2>
        <p class="mono shrink-0 text-3xl leading-none text-fg sm:text-4xl"><span class="sr-only">Price: </span>${service.price}</p>
      </div>
      <p class="mt-3 leading-relaxed text-muted">{service.summary}</p>
      <h3 class="inc-title">What's included</h3>
      <ul class="solder-list mt-3">
        {service.includes.map((i) => <li>{i}</li>)}
      </ul>
      <a href={`/book?service=${service.id}`} class="btn btn-primary mt-7 w-full sm:w-auto">
        Book this mod<span class="sr-only">: {service.name}</span>
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .spot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .spot-media {
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.07),
      0 40px 80px -50px rgb(0 0 0 / 0.95);
  }
  .spot-panel {
    position: relative;
    margin: -3rem 0.75rem 0;
    padding: 1.5rem;
    border-radius: 1.5rem;
    /* it sits over a busy photo: denser than plain .glass so text stays readable even where blur is unsupported */
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.015) 55%),
      rgb(12 17 31 / 0.8);
  }
  .inc-title {
    margin-top: 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }
  @media (width >= 40rem) {
    .spot-panel {
      margin-inline: 2rem;
      padding: 2rem;
    }
  }
  @media (width >= 64rem) {
    .spot-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .spot-media {
      grid-column: 1 / span 8;
      grid-row: 1;
    }
    .spot-panel {
      grid-column: 7 / span 6;
      grid-row: 1;
      margin: 0;
      padding: 2.25rem;
    }
  }
</style>
