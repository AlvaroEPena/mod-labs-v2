---
/**
 * The three Switch modchip services as one panel with a model switcher (OLED / V1-V2 / Lite): near-identical
 * offers compared in place instead of three long cards. Tabs come from src/scripts/tabs.ts; without JS every
 * model's panel is simply shown. Each panel's id is the service id, so /services#switch-lite opens Lite.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import { pricingPhoto } from "../media/picks";
import { services } from "../../data/services";

const models = services.filter((s) => s.platform === "switch");
const shortName = (name: string) => name.replace(/^Switch\s+/, "");
---

<section id="switch" class="section-y ambient scroll-mt-24" style="--ax:80%;--ay:45%" aria-labelledby="switch-title">
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 id="switch-title" class="reveal text-4xl sm:text-5xl">Nintendo Switch modchips</h2>
      <p class="lead reveal mt-5 max-w-md">Three models, three installs. Pick yours to see exactly what you get.</p>
      <div class="sw-frame glass reveal hidden lg:block">
        <Photo photo={pricingPhoto("switch")} ratio="1 / 1" sizes="400px" widths={[400, 800]} class="sw-photo" />
      </div>
    </div>

    <div class="min-w-0 lg:col-span-7" data-tabs>
      <div class="seg glass" role="tablist" aria-label="Switch model" aria-orientation="horizontal" data-tablist hidden>
        <span class="seg-ind" aria-hidden="true"></span>
        {
          models.map((m, i) => (
            <button type="button" role="tab" id={`tab-${m.id}`} aria-controls={m.id} aria-selected={i === 0 ? "true" : "false"} class="seg-tab">
              <span class="seg-name">{shortName(m.name)}</span>
              <span class="mono seg-price">${m.price}</span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        {
          models.map((m) => (
            <article id={m.id} class="sw-panel card scroll-mt-28">
              <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-2">
                <h3 class="text-2xl sm:text-3xl">{m.name}</h3>
                <p class="mono shrink-0 text-4xl leading-none text-fg sm:text-5xl">
                  <span class="sr-only">Price: </span>${m.price}
                </p>
              </div>
              <p class="mt-3 max-w-xl leading-relaxed text-muted">{m.summary}</p>
              <h4 class="inc-title">What's included</h4>
              <ul class="solder-list mt-3">
                {m.includes.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
              <a href={`/book?service=${m.id}`} class="btn btn-primary mt-8 w-full sm:w-auto">
                Book this mod<span class="sr-only">: {m.name}</span>
                <Icon name="arrow" size={18} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/tabs";
</script>

<style>
  .sw-frame {
    margin-top: 2.5rem;
    max-width: 22rem;
    padding: 0.55rem;
    border-radius: 1.9rem;
  }
  .sw-frame :global(.sw-photo) {
    border-radius: 1.4rem;
  }

  /* segmented control: a glass pill with a sliding lit indicator (positioned by tabs.ts) */
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.35rem;
    margin-bottom: 1rem;
    border-radius: 999px;
  }
  .seg[hidden] {
    display: none;
  }
  .seg-ind {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--ind-w, 0);
    height: var(--ind-h, 0);
    transform: translate(var(--ind-x, 0), var(--ind-y, 0));
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(78 224 239 / 0.24), rgb(78 224 239 / 0.1));
    border: 1px solid rgb(78 224 239 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 8px 24px -10px rgb(78 224 239 / 0.6);
    pointer-events: none;
  }
  .seg-tab {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.05rem;
    min-height: 3.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 999px;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .seg-tab:hover,
  .seg-tab[aria-selected="true"] {
    color: var(--color-fg);
  }
  .seg-tab:focus-visible {
    outline-offset: -2px;
    border-radius: 999px;
  }
  .seg-name {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .seg-price {
    font-size: 0.82rem;
    color: var(--color-dim);
    transition: color 0.2s;
  }
  .seg-tab[aria-selected="true"] .seg-price {
    color: var(--color-cyan-soft);
  }
  @media (width >= 40rem) {
    .seg-tab {
      flex-direction: row;
      gap: 0.6rem;
    }
    .seg-price {
      font-size: 0.9rem;
    }
  }

  .panels {
    display: grid;
    gap: 1rem;
  }
  .sw-panel {
    padding: 1.6rem;
  }
  @media (width >= 40rem) {
    .sw-panel {
      padding: 2.25rem;
    }
  }
  .sw-panel[hidden] {
    display: none;
  }
  .inc-title {
    margin-top: 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .seg-ind {
      transition: transform 0.45s var(--ease-out-expo);
    }
    .sw-panel {
      transition:
        opacity 0.4s var(--ease-out-expo),
        transform 0.5s var(--ease-out-expo);
    }
    .sw-panel[data-entered] {
      opacity: 0;
      transform: translateY(10px);
      transition: none;
    }
  }
</style>
