---
/**
 * Home pricing as a 3-cell bento (one cell per offer group, no empty cells):
 *  - Xbox 360 RGH: tall photo tile (the whole tile books it)
 *  - Nintendo Switch: one tile listing the three Switch mods, each row books that mod
 *  - Quote-based work: slim tile pointing to the quote form
 * Prices and copy come from services.ts; the "what's included" bullet lists live on /services.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import { pricingPhoto } from "../media/picks";
import { services } from "../../data/services";

const xbox = services.find((s) => s.id === "xbox-360-rgh")!;
const switchMods = services.filter((s) => s.platform === "switch");
const fromSwitch = Math.min(...switchMods.map((s) => s.price ?? Infinity));
---

<section class="section-y ambient" style="--ax:22%;--ay:28%" aria-labelledby="pricing-title">
  <div class="container-x">
    <div class="max-w-2xl">
      <h2 id="pricing-title" class="reveal text-4xl sm:text-5xl">Straightforward prices. No surprises.</h2>
      <p class="lead reveal mt-5">
        Every priced mod includes the install, a deep clean with fresh thermal paste, and full software setup.
      </p>
    </div>

    <div class="bento reveal-stagger mt-12 grid gap-4 lg:mt-16 lg:grid-cols-12">
      <a href={`/book?service=${xbox.id}`} class="tile-xbox card glow-edge lg:col-span-5 lg:row-span-2">
        <Photo
          photo={pricingPhoto("xbox")}
          ratio="4 / 5"
          sizes="(min-width: 1024px) 460px, 100vw"
          widths={[400, 800]}
          class="tile-photo"
          alt=""
        />
        <span class="tile-shade" aria-hidden="true"></span>
        <span class="tile-xbox-body">
          <span class="block text-3xl font-semibold tracking-[-0.03em] text-fg sm:text-4xl">{xbox.name}</span>
          <span class="mt-3 block max-w-sm leading-relaxed text-muted">{xbox.summary}</span>
          <span class="mt-6 flex items-center justify-between gap-4">
            <span class="mono text-4xl text-fg"><span class="sr-only">Price: </span>${xbox.price}</span>
            <span class="go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
          </span>
          <span class="sr-only">Book {xbox.name}</span>
        </span>
      </a>

      <div class="tile-switch card glow-edge lg:col-span-7">
        <div class="flex items-start justify-between gap-6 p-6 pb-2 sm:p-8 sm:pb-3">
          <div>
            <p class="mono text-xs tracking-[0.14em] text-cyan-soft uppercase">Nintendo Switch</p>
            <h3 class="mt-2 text-2xl sm:text-3xl">Modchip installs</h3>
            <p class="mt-2 text-muted">OLED, V1/V2 and Lite, from <span class="mono text-fg">${fromSwitch}</span>.</p>
          </div>
          <Photo
            photo={pricingPhoto("switch")}
            ratio="1 / 1"
            sizes="96px"
            widths={[200]}
            class="switch-thumb hidden xs:block"
            alt=""
          />
        </div>
        <ul class="px-3 pb-3 sm:px-4 sm:pb-4">
          {
            switchMods.map((s) => (
              <li>
                <a href={`/book?service=${s.id}`} class="mod-row">
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-fg">{s.name}</span>
                    <span class="mt-0.5 block text-sm leading-snug text-muted">{s.summary}</span>
                  </span>
                  <span class="mono text-2xl text-fg">
                    <span class="sr-only">Price: </span>${s.price}
                  </span>
                  <span class="go go-sm" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                  <span class="sr-only">Book {s.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="tile-quote card glow-edge flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:p-8 lg:col-span-7">
        <span class="quote-icon" aria-hidden="true"><Icon name="wrench" size={22} /></span>
        <div class="min-w-0 flex-1">
          <h3 class="text-xl">Repairs and custom work, by quote</h3>
          <p class="mt-1.5 text-muted">Board-level repair, custom shells and RGB lighting. Send a few photos and I'll price it.</p>
        </div>
        <a href="/quote" class="btn btn-ghost shrink-0">Get a quote</a>
      </div>
    </div>

    <a href="/services" class="link-arrow reveal mt-8">See everything that's included <Icon name="arrow" size={18} /></a>
  </div>
</section>

<style>
  .bento {
    grid-auto-rows: auto;
  }

  /* --- Xbox photo tile --- */
  .tile-xbox {
    display: block;
    overflow: hidden;
    min-height: 30rem;
    text-decoration: none;
  }
  .tile-xbox :global(.tile-photo) {
    position: absolute !important;
    inset: 0;
    z-index: -2;
    height: 100%;
    aspect-ratio: auto !important;
  }
  .tile-xbox :global(.tile-photo img) {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .tile-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(5 7 14 / 0.05) 20%, rgb(5 7 14 / 0.6) 52%, rgb(5 7 14 / 0.96) 88%),
      linear-gradient(90deg, rgb(5 7 14 / 0.35), transparent 60%);
  }
  .tile-xbox-body {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.75rem;
  }
  @media (width >= 40rem) {
    .tile-xbox-body {
      padding: 2.25rem;
    }
  }
  @media (width >= 64rem) {
    .tile-xbox {
      min-height: 0;
      height: 100%;
    }
  }

  /* arrow "button" used by clickable tiles/rows */
  .go {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: #04131a;
    background: var(--color-cyan);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5);
    transition: transform 0.35s var(--ease-out-expo);
  }
  .go-sm {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-cyan);
    background: rgb(78 224 239 / 0.08);
    border: 1px solid rgb(78 224 239 / 0.25);
    box-shadow: none;
  }

  /* --- Switch tile --- */
  .tile-switch :global(.switch-thumb) {
    flex: none;
    width: 6rem;
    border-radius: 1.1rem;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .mod-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.9rem 1rem;
    border-radius: 1.1rem;
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .tile-switch li + li {
    border-top: 1px solid var(--color-line-soft);
  }
  .mod-row:hover {
    background: rgb(255 255 255 / 0.04);
  }

  /* --- Quote tile --- */
  .quote-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-cyan);
    background: rgb(78 224 239 / 0.08);
    border: 1px solid rgb(78 224 239 / 0.25);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile-xbox:hover :global(.tile-photo img) {
      transform: scale(1.04);
    }
    .tile-xbox:hover .go,
    .mod-row:hover .go {
      transform: translateX(3px);
    }
  }
</style>
