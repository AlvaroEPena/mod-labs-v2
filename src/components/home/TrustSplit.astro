---
/** Home "why Mod Labs": the microscope bench in a glass frame (with the one real number: 9+ years) beside four reasons. */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../ui/icons";
import { benchPhoto } from "../media/picks";

const points: { icon: IconName; title: string; body: string }[] = [
  { icon: "microscope", title: "Microscope-level work", body: "Precision soldering under magnification, with strain relief and Kapton where it counts." },
  { icon: "shield", title: "Tested before pickup", body: "Every console is fully tested before it goes home. If I spot prior damage, you hear it from me first." },
  { icon: "chat", title: "Noob-friendly", body: "Ask anything. I keep you updated and walk you through your setup when you pick up." },
  { icon: "clock", title: "Fast local turnaround", body: "Seattle drop-offs are usually done the same or next day." },
];
---

<section class="section-y ambient" style="--ax:20%;--ay:30%" aria-labelledby="trust-title">
  <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="trust-visual reveal relative lg:col-span-5">
      <div class="trust-frame glass">
        <Photo
          photo={benchPhoto()}
          ratio="4 / 5"
          sizes="(min-width: 1024px) 440px, 90vw"
          widths={[400, 800]}
          class="trust-photo"
          alt="Alvaro's workbench: a digital microscope over a Nintendo Switch board mid-install"
        />
      </div>
      <p class="trust-stat glass">
        <span class="mono text-4xl text-fg">9+</span>
        <span class="text-sm leading-snug text-muted">years repairing and modding hardware</span>
      </p>
    </div>

    <div class="lg:col-span-7 lg:pl-8">
      <h2 id="trust-title" class="reveal max-w-xl text-4xl sm:text-5xl">Treated like it's staying in my own collection.</h2>
      <p class="lead reveal mt-5 max-w-xl">Clean flux habits, careful board handling and a full test before anything goes back to you.</p>
      <ul class="reveal-stagger mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2">
        {
          points.map((p) => (
            <li>
              <span class="trust-icon" aria-hidden="true">
                <Icon name={p.icon} size={22} />
              </span>
              <h3 class="mt-4 text-lg">{p.title}</h3>
              <p class="mt-1.5 leading-relaxed text-muted">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .trust-visual {
    max-width: 26rem;
    margin-inline: auto;
    width: 100%;
  }
  .trust-frame {
    padding: 0.6rem;
    border-radius: 2rem;
  }
  .trust-frame :global(.trust-photo) {
    border-radius: 1.45rem;
  }
  .trust-stat {
    position: absolute;
    right: -0.75rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 15rem;
    padding: 0.9rem 1.15rem;
    border-radius: 1.25rem;
  }
  @media (width >= 64rem) {
    .trust-stat {
      right: -2.5rem;
    }
  }
  .trust-icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 999px;
    color: var(--color-cyan);
    background: rgb(78 224 239 / 0.08);
    border: 1px solid rgb(78 224 239 / 0.25);
  }
</style>
