---
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import { buildCover } from "../media/picks";
import type { Build } from "../../data/builds";

interface Props {
  build: Build;
  index: number;
}
const { build, index } = Astro.props;
const photo = buildCover(build.slug);
---

<article class="card glow-edge build overflow-hidden">
  <div class="relative overflow-hidden rounded-t-[inherit]">
    <Photo
      photo={photo}
      ratio="4 / 3"
      sizes="(min-width: 1024px) 580px, (min-width: 640px) 90vw, 100vw"
      widths={[400, 800, 1200]}
      class="build-photo"
    />
    <div class="build-fade" aria-hidden="true"></div>
    <p class="glass absolute top-4 left-4 chip text-fg">
      <Icon name="hand" size={16} class="text-cyan" /> Made to order
    </p>
  </div>
  <div class="relative -mt-14 p-6 sm:p-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h3 class="text-2xl sm:text-3xl">{build.name}</h3>
      <p class="price-tag text-3xl" style={`--shimmer-delay:${2 + index}s`}>
        <span class="sr-only">Price: </span><span class="cur">$</span>{build.price}
      </p>
    </div>
    <p class="mt-3 leading-relaxed text-muted">{build.tagline}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Highlights">
      {build.features.slice(0, 4).map((f) => <li class="chip">{f.title}</li>)}
    </ul>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={`/builds#${build.slug}`} class="btn btn-ghost">See the build<span class="sr-only">: {build.name}</span></a>
      <a href={`/quote?build=${build.slug}`} class="btn btn-primary">Request this build<span class="sr-only">: {build.name}</span></a>
    </div>
  </div>
</article>

<style>
  .build :global(.build-photo img) {
    transition: transform 0.9s var(--ease-out-expo);
  }
  @media (prefers-reduced-motion: no-preference) {
    .build:hover :global(.build-photo img) {
      transform: scale(1.04);
    }
  }
  .build-fade {
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(180deg, transparent, rgb(17 21 56) 92%);
    pointer-events: none;
  }
</style>
