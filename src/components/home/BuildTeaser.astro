---
/**
 * Commission build card: the build's beauty shot with a frosted-glass panel docked over the bottom of
 * the photo (from sm up). On phones the panel sits just below the photo, overlapping it slightly, so the
 * image stays visible; there it is blur-free (spec §18 blur budget) with an opaque fill that hides the
 * photo's edge.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import { buildCover } from "../media/picks";
import type { Build } from "../../data/builds";

interface Props {
  build: Build;
  /** photo crop, e.g. "4 / 3" for the wide card, "4 / 5" for the tall one */
  ratio: string;
  sizes: string;
  class?: string;
}
const { build, ratio, sizes, class: cls } = Astro.props;
---

<article class:list={["build", cls]}>
  <div class="build-photo-wrap">
    <Photo photo={buildCover(build.slug)} {ratio} {sizes} widths={[400, 800, 1200]} class="build-photo" />
  </div>
  <div class="build-panel glass-flat">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h3 class="text-2xl sm:text-[1.7rem]">{build.name}</h3>
        <p class="mt-2 leading-relaxed text-muted">{build.tagline}</p>
      </div>
      <p class="mono shrink-0 text-3xl text-fg"><span class="sr-only">Price: </span>${build.price}</p>
    </div>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Highlights">
      {build.features.slice(0, 3).map((f) => <li class="chip">{f.title}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-2.5">
      <a href={`/quote?build=${build.slug}`} class="btn btn-primary">
        Request this build<span class="sr-only">: {build.name}</span>
      </a>
      <a href={`/builds#${build.slug}`} class="btn btn-ghost">
        See the build<span class="sr-only">: {build.name}</span>
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .build {
    position: relative;
  }
  .build-photo-wrap {
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.07),
      0 40px 80px -50px rgb(0 0 0 / 0.95);
  }
  .build :global(.build-photo img) {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .build-panel {
    --glass-fill: rgb(12 17 31); /* the glass tint, opaque: any see-through shows the photo's crisp edge */
    position: relative;
    margin: -2.5rem 0.75rem 0;
    padding: 1.4rem;
    border-radius: 1.25rem;
  }
  @media (width >= 40rem) {
    /* docked over the photo from here, so it gets the real frost like every photo overlay */
    .build-panel {
      --glass-fill: rgb(12 17 31 / 0.55);
      position: absolute;
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      margin: 0;
      padding: 1.6rem 1.75rem;
      backdrop-filter: var(--glass-frost);
      -webkit-backdrop-filter: var(--glass-frost);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .build:hover :global(.build-photo img) {
      transform: scale(1.035);
    }
  }
</style>
