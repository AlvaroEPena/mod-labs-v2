---
/**
 * Home gallery teaser: a full-bleed, scroll-snapping rail of the five gallery categories. The first card
 * lines up with the page container; the rail bleeds off the right edge to signal "there's more".
 * Prev/next buttons (md+) scroll by one card; swipe/trackpad works everywhere.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import { categoryCover } from "../media/picks";
import { categories, photosInCategory } from "../../data/gallery";
---

<section class="section-y overflow-hidden" aria-labelledby="work-title">
  <div class="container-x flex items-end justify-between gap-8">
    <div class="max-w-2xl">
      <h2 id="work-title" class="reveal text-4xl sm:text-5xl">Straight from my bench.</h2>
      <p class="lead reveal mt-5">Real photos of real jobs, from microscope shots of solder points to finished consoles.</p>
    </div>
    <div class="hidden shrink-0 gap-2 md:flex" data-rail-controls>
      <button type="button" class="rail-btn" data-rail-prev aria-label="Previous categories" aria-controls="work-rail">
        <Icon name="arrow-left" size={18} />
      </button>
      <button type="button" class="rail-btn" data-rail-next aria-label="More categories" aria-controls="work-rail">
        <Icon name="arrow" size={18} />
      </button>
    </div>
  </div>

  <ul id="work-rail" class="rail mt-12" aria-label="Gallery categories">
    {
      categories.map((c) => (
        <li class="rail-item">
          <a href={`/gallery/${c.slug}`} class="cat-card card glow-edge">
            <Photo photo={categoryCover(c.slug)} ratio="3 / 4" sizes="(min-width: 1024px) 340px, 72vw" widths={[400, 800]} class="cat-photo" alt="" />
            <span class="cat-shade" aria-hidden="true" />
            <span class="cat-caption glass-flat">
              <span class="min-w-0">
                <span class="block truncate font-semibold text-fg">{c.short}</span>
                <span class="mono mt-0.5 block text-xs text-muted">{photosInCategory(c.slug).length} photos</span>
              </span>
              <Icon name="arrow" size={18} class="shrink-0 text-cyan" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="container-x mt-8">
    <a href="/gallery" class="link-arrow">Open the full gallery <Icon name="arrow" size={18} /></a>
  </div>
</section>

<style>
  .rail {
    /* align the first card with the container's content edge */
    --edge: max(1.125rem, calc((100% - 78rem) / 2 + 2rem));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(15.5rem, 70vw, 21rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    padding: 0.25rem var(--edge) 1.5rem;
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  @media (width >= 48rem) {
    .rail {
      --edge: max(1.75rem, calc((100% - 78rem) / 2 + 2rem));
      grid-auto-columns: clamp(17rem, 30vw, 21rem);
      gap: 1.25rem;
    }
  }
  .rail-item {
    scroll-snap-align: start;
  }
  .cat-card {
    display: block;
    overflow: hidden;
    text-decoration: none;
  }
  .cat-card :global(.cat-photo) {
    position: relative;
    z-index: -2;
  }
  .cat-card :global(.cat-photo img) {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .cat-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent 50%, rgb(5 7 14 / 0.75));
  }
  .cat-caption {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-radius: 1rem;
  }
  .rail-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-fg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
    border: 1px solid rgb(255 255 255 / 0.14);
    cursor: pointer;
    transition:
      border-color 0.2s,
      opacity 0.2s;
  }
  .rail-btn:hover {
    border-color: rgb(78 224 239 / 0.5);
  }
  .rail-btn[aria-disabled="true"] {
    opacity: 0.35;
    cursor: default;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cat-card:hover :global(.cat-photo img) {
      transform: scale(1.05);
    }
  }
</style>

<script>
  // Prev/next scroll the rail by one card; buttons dim at either end.
  const rail = document.getElementById("work-rail");
  const prev = document.querySelector<HTMLButtonElement>("[data-rail-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-rail-next]");
  if (rail && prev && next) {
    const smooth = matchMedia("(prefers-reduced-motion: no-preference)").matches ? "smooth" : "auto";
    const step = () => {
      const item = rail.querySelector<HTMLElement>(".rail-item");
      const gap = parseFloat(getComputedStyle(rail).columnGap) || 0;
      return (item?.offsetWidth ?? 300) + gap;
    };
    const sync = () => {
      const atStart = rail.scrollLeft <= 2;
      const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
      prev.setAttribute("aria-disabled", String(atStart));
      next.setAttribute("aria-disabled", String(atEnd));
    };
    prev.addEventListener("click", () => rail.scrollBy({ left: -step(), behavior: smooth }));
    next.addEventListener("click", () => rail.scrollBy({ left: step(), behavior: smooth }));
    rail.addEventListener("scroll", sync, { passive: true });
    new ResizeObserver(sync).observe(rail);
    sync();
  }
</script>
