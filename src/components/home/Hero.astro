---
/**
 * Home hero: asymmetric split. Copy left (eyebrow, headline, one-sentence promise, two CTAs);
 * right, the GWii in a glass frame wired into the powered-on circuit traces, with a frosted-glass
 * commission card centred across the frame's bottom edge.
 */
import Photo from "../media/Photo.astro";
import Icon from "../ui/Icon.astro";
import CircuitArt from "./CircuitArt.astro";
import { heroPhoto } from "../media/picks";
import { builds } from "../../data/builds";

const photo = heroPhoto();
const gwii = builds.find((b) => b.slug === "gwii")!;
---

<section class="hero relative isolate" aria-labelledby="hero-title">
  <div class="container-x hero-grid">
    <div class="hero-copy min-w-0">
      <p class="eyebrow hero-in" style="--o:0">Seattle drop-off · Mail-in welcome</p>
      <h1 id="hero-title" class="hero-title hero-in" style="--o:1">
        Console modding,<br />
        <span class="text-gradient pb-1">done right.</span>
      </h1>
      <p class="lead hero-in mt-6 max-w-[33rem]" style="--o:2">
        Switch modchips, Xbox 360 RGH and board-level repair. Hand-soldered by me, Alvaro, and explained in plain
        English.
      </p>
      <div class="hero-in mt-9 flex flex-col gap-3 xs:flex-row" style="--o:3">
        <a href="/book" class="btn btn-primary btn-lg">Book a service <Icon name="arrow" size={18} /></a>
        <a href="/quote" class="btn btn-ghost btn-lg">Get a quote</a>
      </div>
    </div>

    <div class="hero-visual">
      <CircuitArt />
      <div class="hero-light" aria-hidden="true"></div>
      <div class="hero-frame glass-flat">
        <Photo
          photo={photo}
          priority
          ratio="4 / 5"
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 420px, (min-width: 640px) 380px, 320px"
          class="hero-photo"
          alt="The GWii, a purple handheld Wii built by Mod Labs from a real Wii motherboard, running New Super Mario Bros. Wii"
        />
      </div>
      <a href="/builds#gwii" class="hero-card glass">
        <span class="hero-card-icon" aria-hidden="true"><Icon name="chip" size={20} /></span>
        <span class="min-w-0 flex-1">
          <span class="mono block text-[0.7rem] tracking-[0.14em] text-cyan-soft uppercase">Commission build</span>
          <span class="mt-0.5 block truncate font-semibold text-fg">GWii handheld</span>
        </span>
        <span class="mono text-lg text-fg"><span class="sr-only">Price: </span>${gwii.price}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* the circuit art reaches past the frame; clip sideways only so the card can hang below */
    overflow-x: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 5rem;
    padding-top: 2.5rem;
    padding-bottom: 4.5rem;
  }
  @media (width < 64rem) {
    .hero-visual :global(.circuit) {
      mask-image: linear-gradient(180deg, transparent 4%, #000 16%);
    }
  }
  @media (width >= 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 3rem;
      min-height: min(calc(100dvh - var(--header-h)), 54rem);
      padding-top: 1.5rem;
      padding-bottom: 3rem;
    }
  }

  .hero-title {
    margin-top: 1.5rem;
    /* "Console modding," must fit one line from lg up (2-line headline) */
    font-size: clamp(2.6rem, 1.35rem + 4.4vw, 4.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero-visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 20rem;
  }
  @media (width >= 23.4rem) {
    .hero-visual {
      max-width: 21.5rem;
    }
  }
  @media (width >= 40rem) {
    .hero-visual {
      max-width: 24rem;
    }
  }
  @media (width >= 64rem) {
    .hero-visual {
      max-width: 26.5rem;
    }
  }

  /* ambient light pooling under the glass (what makes it read as glass, not a box) */
  .hero-light {
    position: absolute;
    inset: 8% -18% -6%;
    z-index: 0;
    background:
      radial-gradient(closest-side at 50% 45%, rgb(78 224 239 / 0.28), transparent 72%),
      radial-gradient(closest-side at 70% 80%, rgb(139 124 246 / 0.22), transparent 70%);
    filter: blur(10px);
    pointer-events: none;
  }

  .hero-frame {
    /* blur-free: the trace pads and pulses animate right at its edge, and a frost over moving art repaints
       every frame on phones. The denser fill hides the inner halves of the pads that straddle the edge. */
    --glass-fill: rgb(12 17 31 / 0.86);
    position: relative;
    z-index: 1;
    padding: 0.6rem;
    border-radius: 2rem;
  }
  .hero-frame :global(.hero-photo) {
    border-radius: 1.45rem;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .hero-card {
    position: absolute;
    z-index: 2;
    /* equal insets keep the card centred on the frame, straddling its bottom edge */
    left: 7%;
    right: 7%;
    bottom: -1.9rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1.1rem 0.7rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    transition:
      border-color 0.25s,
      transform 0.4s var(--ease-out-expo);
  }
  .hero-card:hover {
    border-color: rgb(78 224 239 / 0.45);
  }
  .hero-card-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    color: var(--color-cyan);
    background: rgb(78 224 239 / 0.1);
    border: 1px solid rgb(78 224 239 / 0.28);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.95s var(--ease-out-expo) both;
      animation-delay: calc(0.05s + var(--o) * 0.08s);
    }
    .hero-frame {
      animation: frame-on 1.2s var(--ease-out-expo) 0.1s both;
    }
    .hero-card {
      animation: card-on 0.9s var(--ease-out-expo) 1.05s both;
    }
    .hero-card:hover {
      transform: translateY(-2px);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0.01; /* >0 keeps text eligible as LCP from first paint */
      transform: translateY(18px);
    }
  }
  @keyframes frame-on {
    from {
      opacity: 0.01;
      transform: translateY(14px) scale(0.965);
    }
  }
  @keyframes card-on {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
