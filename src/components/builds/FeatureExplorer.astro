---
/**
 * Spec explorer for one build: its features as a grid of PCB-style "pads" (an ARIA tablist) driving a
 * single glass readout. Tapping a pad powers it on and swaps the readout, so a 9-item spec list reads
 * like inspecting the board instead of a long bullet list. Without JS (src/scripts/tabs.ts not run)
 * every feature is shown as its own small card, so nothing is ever hidden from people or crawlers.
 */
import Icon from "../ui/Icon.astro";
import { featureIcon } from "./feature-icons";
import type { Build } from "../../data/builds";

interface Props {
  build: Build;
}
const { build } = Astro.props;
const id = (i: number) => `${build.slug}-feat-${i}`;
---

<div class="explorer" data-tabs>
  <h3 class="reveal text-2xl sm:text-3xl">What makes it special</h3>
  <div class="ex-grid mt-7">
    <div class="pads" role="tablist" aria-label={`${build.name} features`} data-tablist hidden>
      {
        build.features.map((f, i) => (
          <button type="button" role="tab" id={`${id(i)}-tab`} aria-controls={id(i)} aria-selected={i === 0 ? "true" : "false"} class="pad">
            <Icon name={featureIcon(f.title)} size={22} class="pad-icon" />
            <span class="pad-label">{f.title}</span>
          </button>
        ))
      }
    </div>
    <div class="readouts">
      {
        build.features.map((f, i) => (
          <div id={id(i)} class="readout card">
            <svg class="ro-traces" viewBox="0 0 400 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M400 34H336l-24 24h-30" />
              <path d="M400 166H350l-22-22" />
            </svg>
            <span class="ro-icon" aria-hidden="true">
              <Icon name={featureIcon(f.title)} size={30} />
            </span>
            <p class="ro-title">{f.title}</p>
            <p class="ro-detail">{f.detail}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import "../../scripts/tabs";
</script>

<style>
  .explorer {
    margin-top: 4.5rem;
  }
  .ex-grid {
    display: grid;
    gap: 1rem;
  }

  /* --- no JS: every feature is a small card in a grid --- */
  .readouts {
    display: grid;
    gap: 0.75rem;
  }
  @media (width >= 40rem) {
    .readouts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .readout {
    position: relative;
    overflow: hidden;
    padding: 1.25rem;
  }
  .ro-traces {
    display: none;
  }
  .ro-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    color: var(--color-cyan);
    background: rgb(78 224 239 / 0.08);
    border: 1px solid rgb(78 224 239 / 0.3);
  }
  .ro-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .ro-title {
    margin-top: 1rem;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
    color: var(--color-fg);
  }
  .ro-detail {
    margin-top: 0.4rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* --- enhanced: pads + one readout --- */
  [data-tabs-ready] .readouts {
    display: block;
  }
  [data-tabs-ready] .readout {
    min-height: 15.5rem;
    padding: 1.75rem;
    background:
      radial-gradient(26rem 14rem at 0% 0%, rgb(78 224 239 / 0.12), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015) 60%),
      rgb(12 17 31 / 0.72);
  }
  [data-tabs-ready] .readout[hidden] {
    display: none;
  }
  [data-tabs-ready] .ro-traces {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(78 224 239 / 0.22);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }
  [data-tabs-ready] .ro-traces path {
    vector-effect: non-scaling-stroke;
  }
  [data-tabs-ready] .ro-icon {
    position: relative;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 1.3rem;
    background:
      radial-gradient(closest-side, rgb(78 224 239 / 0.28), transparent),
      var(--color-panel);
    border-color: rgb(78 224 239 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 0 34px -6px rgb(78 224 239 / 0.55);
  }
  [data-tabs-ready] .ro-icon :global(svg) {
    width: 2rem;
    height: 2rem;
  }
  [data-tabs-ready] .ro-title {
    position: relative;
    margin-top: 1.4rem;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.85rem);
    line-height: 1.15;
  }
  [data-tabs-ready] .ro-detail {
    position: relative;
    max-width: 34rem;
    font-size: 1.05rem;
  }

  .pads {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .pads[hidden] {
    display: none;
  }
  .pad {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 5.25rem;
    padding: 0.8rem 0.8rem 0.75rem;
    border-radius: 1rem;
    text-align: left;
    color: var(--color-muted);
    background: rgb(255 255 255 / 0.03);
    border: 1px solid var(--color-line-soft);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 0.2s,
      border-color 0.25s,
      background-color 0.25s,
      box-shadow 0.3s,
      transform 0.25s var(--ease-out-expo);
  }
  .pad:hover {
    color: var(--color-fg);
    border-color: rgb(255 255 255 / 0.2);
  }
  .pad:active {
    transform: scale(0.97);
  }
  .pad :global(.pad-icon) {
    color: var(--color-dim);
    transition: color 0.2s;
  }
  .pad-label {
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }
  .pad[aria-selected="true"] {
    color: var(--color-fg);
    border-color: rgb(78 224 239 / 0.6);
    background:
      radial-gradient(10rem 6rem at 0% 0%, rgb(78 224 239 / 0.16), transparent 70%),
      rgb(78 224 239 / 0.05);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 10px 28px -16px rgb(78 224 239 / 0.7);
  }
  .pad[aria-selected="true"] :global(.pad-icon) {
    color: var(--color-cyan);
  }
  .pad:focus-visible {
    outline-offset: 2px;
    border-radius: 1rem;
  }
  @media (width >= 40rem) {
    .pad {
      min-height: 4.75rem;
      padding: 0.9rem 1rem;
    }
    .pad-label {
      font-size: 0.92rem;
    }
  }
  @media (width >= 64rem) {
    .ex-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: stretch;
      gap: 1.25rem;
    }
    [data-tabs-ready] .readout {
      height: 100%;
      padding: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-tabs-ready] .readout > * {
      transition:
        opacity 0.45s var(--ease-out-expo),
        transform 0.55s var(--ease-out-expo);
    }
    [data-tabs-ready] .readout[data-entered] > * {
      opacity: 0;
      transform: translateY(8px);
      transition: none;
    }
    [data-tabs-ready] .readout[data-entered] > .ro-traces {
      transform: none;
    }
    [data-tabs-ready] .ro-traces path {
      stroke-dasharray: 600;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.1s var(--ease-snap);
    }
    [data-tabs-ready] .readout[data-entered] .ro-traces path {
      stroke-dashoffset: 600;
      transition: none;
    }
  }
</style>
