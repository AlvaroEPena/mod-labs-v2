---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
---

<BaseLayout title="Signal lost" description="This page doesn't exist." noindex>
  <section class="relative isolate flex min-h-[70vh] items-center overflow-hidden">
    <div class="pcb absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="noise -z-10" aria-hidden="true"></div>
    <div class="container-x py-20 text-center">
      <p class="eyebrow justify-center">Error 404</p>
      <h1 class="glitch mx-auto mt-6 text-5xl sm:text-8xl" data-text="SIGNAL LOST">SIGNAL LOST</h1>
      <p class="lead mx-auto mt-6 max-w-lg">
        No input detected on this channel. The page you're looking for was moved, never existed, or got its traces cut.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary btn-lg"><Icon name="home" size={18} /> Back to home</a>
        <a href="/gallery" class="btn btn-ghost btn-lg">Browse the gallery</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .noise {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 3px);
  }
  .glitch {
    position: relative;
    display: inline-block;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-fg);
    text-shadow: 0 0 30px rgb(0 229 255 / 0.4);
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glitch::before {
    color: var(--color-cyan);
    transform: translate(-3px, 0);
    clip-path: inset(10% 0 55% 0);
    opacity: 0.8;
  }
  .glitch::after {
    color: var(--color-magenta);
    transform: translate(3px, 0);
    clip-path: inset(60% 0 8% 0);
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .glitch::before {
      animation: glitch-a 2.6s steps(1) infinite;
    }
    .glitch::after {
      animation: glitch-b 3.1s steps(1) infinite;
    }
  }
  @keyframes glitch-a {
    0%,
    100% {
      transform: translate(-3px, 0);
    }
    20% {
      transform: translate(-7px, -2px);
    }
    40% {
      transform: translate(2px, 1px);
    }
    60% {
      transform: translate(-4px, 2px);
    }
  }
  @keyframes glitch-b {
    0%,
    100% {
      transform: translate(3px, 0);
    }
    25% {
      transform: translate(7px, 2px);
    }
    50% {
      transform: translate(-2px, -1px);
    }
    75% {
      transform: translate(4px, -2px);
    }
  }
</style>
