---
/**
 * 404 "signal lost" (spec §16 phase 2). Job: recover the visitor quickly. A glass oscilloscope screen with
 * a flatline that keeps sweeping for a signal (storytelling, motion-gated; static trace under reduced
 * motion), the H1, and the ways back.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";

const links = [
  { href: "/services", label: "Services & pricing" },
  { href: "/builds", label: "Custom builds" },
  { href: "/reviews", label: "Reviews" },
  { href: "/faq", label: "FAQ" },
];
/** flatline with one small blip in the middle (viewBox 600x200) */
const trace = "M0 100H250L262 100L272 64L286 138L298 82L308 100H600";
---

<BaseLayout title="Signal lost" description="This page doesn't exist." noindex>
  <section class="lost ambient" aria-labelledby="lost-title">
    <div class="container-x py-12 text-center sm:py-20">
      <div class="scope glass" aria-hidden="true">
        <svg viewBox="0 0 600 200" preserveAspectRatio="none" focusable="false">
          <g class="grid">
            {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => <path d={`M${i * 60} 0V200`} />)}
            {[1, 2, 3].map((i) => <path d={`M0 ${i * 50}H600`} />)}
          </g>
          <path class="line-glow" d={trace} />
          <path class="line" d={trace} />
          <path class="sweep" d={trace} pathLength="1" />
        </svg>
        <span class="scope-label mono">NO INPUT</span>
      </div>

      <h1 id="lost-title" class="lost-title mt-10">SIGNAL LOST</h1>
      <p class="lead mx-auto mt-5 max-w-lg">
        No input detected on this channel. The page you're looking for was moved, never existed, or got its traces cut.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 xs:flex-row">
        <a href="/" class="btn btn-primary btn-lg"><Icon name="home" size={18} /> Back to home</a>
        <a href="/gallery" class="btn btn-ghost btn-lg">Browse the gallery</a>
      </div>
      <nav aria-label="Other pages" class="mt-10">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-1">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="link-arrow text-sm">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    --ax: 50%;
    --ay: 38%;
    display: flex;
    align-items: center;
    min-height: calc(100dvh - var(--header-h) - 6rem);
  }
  .scope {
    position: relative;
    max-width: 34rem;
    margin-inline: auto;
    aspect-ratio: 3 / 1.15;
    padding: 0.9rem;
    border-radius: 1.75rem;
    overflow: hidden;
  }
  .scope svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .grid path {
    stroke: rgb(255 255 255 / 0.06);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .line {
    stroke: rgb(78 224 239 / 0.55);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .line-glow {
    stroke: rgb(78 224 239 / 0.14);
    stroke-width: 10;
    vector-effect: non-scaling-stroke;
  }
  .sweep {
    display: none;
    stroke: #effdff;
    stroke-width: 2.6;
    vector-effect: non-scaling-stroke;
  }
  .scope-label {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--color-dim);
  }
  .lost-title {
    font-size: clamp(3rem, 1.6rem + 7vw, 6.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-fg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sweep {
      display: inline;
      stroke-dasharray: 0.12 1;
      stroke-dashoffset: 0.12;
      animation: sweep 3.2s linear infinite;
    }
    .line {
      animation: flicker 3.2s steps(1) infinite;
    }
  }
  @keyframes sweep {
    0% {
      stroke-dashoffset: 0.12;
      opacity: 0;
    }
    8%,
    80% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
  }
  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
    }
    47% {
      opacity: 0.6;
    }
    49% {
      opacity: 1;
    }
  }
</style>
