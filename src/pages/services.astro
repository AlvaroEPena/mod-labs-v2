---
/**
 * Services & pricing (spec §16 phase 2). Job: find your console, see the price and exactly what's
 * included, then book. Layout families: split hero with the price board → photo + glass spec panel
 * (Xbox) → model switcher (Switch, interactive) → quote bento → two-route hub → CTA slab.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import PriceBoard from "../components/services/PriceBoard.astro";
import ServiceSpotlight from "../components/services/ServiceSpotlight.astro";
import SwitchModels from "../components/services/SwitchModels.astro";
import QuoteWork from "../components/services/QuoteWork.astro";
import DeliveryRoutes from "../components/services/DeliveryRoutes.astro";
import FinalCta from "../components/ui/FinalCta.astro";
import Icon from "../components/ui/Icon.astro";
import { categoryCover } from "../components/media/picks";
import { servicesLd } from "../components/layout/seo";
import { services } from "../data/services";
import { site } from "../data/site";

const xbox = services.find((s) => s.platform === "xbox")!;
const siteUrl = (Astro.site?.toString() ?? site.url).replace(/\/$/, "");
const priceList = services.map((s) => `${s.name} $${s.price}`).join(", ");
---

<BaseLayout
  title="Services & Pricing"
  description={`Seattle console modding prices: ${priceList}. Repairs and custom shells by quote.`}
  jsonLd={[servicesLd(siteUrl)]}
  breadcrumbs={[{ name: "Services & pricing", path: "/services" }]}
>
  <PageHero
    title="Mods and repairs, priced upfront."
    highlight="priced upfront."
    intro="One flat price per console, set before anything gets opened up, plus a walkthrough so you know how to use it."
  >
    <div class="mt-8 flex flex-col gap-3 xs:flex-row">
      <a href="/book" class="btn btn-primary btn-lg">Book a service <Icon name="arrow" size={18} /></a>
      <a href="/quote" class="btn btn-ghost btn-lg">Get a quote</a>
    </div>
    <PriceBoard slot="aside" />
  </PageHero>

  <ServiceSpotlight service={xbox} photo={categoryCover("xbox")} />
  <SwitchModels />
  <QuoteWork />
  <DeliveryRoutes />

  <FinalCta title="Know what you want? Let's do it." />
</BaseLayout>
