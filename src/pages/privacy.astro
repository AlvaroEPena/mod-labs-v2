---
/** Privacy (spec §16 phase 2): compact hero → long-form doc with a scrollspy table of contents. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import LegalDoc, { type LegalSection } from "../components/legal/LegalDoc.astro";

const sections: LegalSection[] = [
  {
    id: "what-i-collect",
    title: "What I collect",
    html: `<p>When you use the booking or quote forms, I collect what you enter: your name, email, phone number (optional), how you'll get the device to me, the services or request type you pick, your message and any photos you attach. When you leave a review, I collect your name, star rating, the service and how you heard about Mod Labs (both optional) and your review. Reviews don't ask for your email. There are no accounts on this site.</p>`,
  },
  {
    id: "how-the-forms-work",
    title: "How the forms work",
    html: `<p>Form submissions are processed on Cloudflare, which hosts this site. To block spam, the forms use <strong>Cloudflare Turnstile</strong>, which may check basic browser and device signals to tell people from bots. Booking and quote requests are then emailed to me through <strong>Resend</strong>, an email delivery service, along with any photos you attached. Photos are resized in your browser before they're sent, which also drops their location data.</p>`,
  },
  {
    id: "reviews",
    title: "Reviews",
    html: `<p>Reviews are stored in a Cloudflare database and stay private until I approve them. Each new review is emailed to me through Resend so I can check it. Once approved, your name, rating and review, plus the service and how you heard about Mod Labs if you picked them, are shown publicly on this site. You can ask me to remove your review at any time.</p>`,
  },
  {
    id: "why-i-use-it",
    title: "Why I use it",
    html: `<p>Only to reply to your request, give you a quote, schedule the work, coordinate drop-off or shipping, and show the reviews you chose to share. I don't sell your personal information, and I don't use it for advertising.</p>`,
  },
  {
    id: "how-long-i-keep-it",
    title: "How long I keep it",
    html: `<p>Requests are kept as long as needed for the job and for reasonable business records, unless the law requires longer. You can ask me to delete your information at any time.</p>`,
  },
  {
    id: "cookies-and-analytics",
    title: "Cookies & analytics",
    html: `<p>This site doesn't use advertising or tracking cookies. Cloudflare may process technical data (like IP addresses) to deliver the site securely and prevent abuse.</p>`,
  },
  {
    id: "devices-and-data",
    title: "Devices & data on hardware",
    html: `<p>Consoles and other devices may contain your accounts, saves and personal files. Please back up anything important before handing a device over. Typical mod installs don't require wiping storage, and I don't go through your data.</p>`,
  },
  {
    id: "questions",
    title: "Questions or requests",
    html: `<p>To ask about or delete your information, send a message through the <a href="/quote">quote form</a> and pick "General question".</p>`,
  },
];
---

<BaseLayout
  title="Privacy"
  description="How Mod Labs collects, uses and keeps information when you book a service, request a quote, leave a review or send a device in."
  breadcrumbs={[{ name: "Privacy", path: "/privacy" }]}
>
  <PageHero title="Privacy" intro="The plain-language version of how I handle your information." compact />
  <LegalDoc sections={sections} updated="November 2026" />
</BaseLayout>
