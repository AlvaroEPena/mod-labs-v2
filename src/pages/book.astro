---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import BookForm from "../components/forms/BookForm.astro";
import FormAside from "../components/forms/FormAside.astro";
import { services, formatPrice } from "../data/services";
---

<BaseLayout
  title="Book a Service"
  description="Book a console mod in Seattle: Xbox 360 RGH, Switch OLED Kamikaze, Switch V1/V2 or Switch Lite modchip. Local drop-off or mail-in."
  ctaBar={false}
>
  <PageHero
    eyebrow="Book a service"
    title="Let's get your console modded"
    highlight="modded"
    intro="Pick your mod, tell me a bit about your console, and I'll reply to confirm the price and a drop-off time. Takes about two minutes."
    compact
  />
  <section class="section-y pt-10 sm:pt-12">
    <div class="container-x grid items-start gap-8 lg:grid-cols-[1.6fr_1fr] lg:gap-12">
      <div class="card p-5 sm:p-8">
        <BookForm />
      </div>
      <div class="grid gap-5 lg:sticky lg:top-24">
        <FormAside
          title="What happens next"
          steps={[
            { icon: "chat", text: "I read your request and reply by email, usually within a day." },
            { icon: "check", text: "We confirm the price, timing and drop-off (or shipping) together." },
            { icon: "sparkle", text: "You get it back cleaned, tested and set up, with a walkthrough." },
          ]}
        />
        <div class="card p-6 sm:p-7">
          <h2 class="text-xl">Prices</h2>
          <ul class="mt-4 grid gap-2.5">
            {
              services.map((s) => (
                <li class="flex items-center justify-between gap-4 border-b border-line-soft pb-2.5 last:border-0 last:pb-0">
                  <span class="text-muted">{s.name}</span>
                  <span class="font-display text-lg font-bold text-fg">{formatPrice(s.price)}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-dim">
            Need a repair, PS4 work or something custom? <a href="/quote" class="font-semibold text-cyan underline-offset-2 hover:underline"
              >Get a quote instead</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
