---
/** One gallery category (deep-linkable, e.g. "see my Switch work"): same body as /gallery, filtered. */
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import GalleryView from "../../components/gallery/GalleryView.astro";
import FinalCta from "../../components/ui/FinalCta.astro";
import { categories, photosInCategory, type Category } from "../../data/gallery";

export const getStaticPaths = (() => categories.map((c) => ({ params: { category: c.slug }, props: { cat: c } }))) satisfies GetStaticPaths;

interface Props {
  cat: Category;
}
const { cat } = Astro.props;
const count = photosInCategory(cat.slug).length;
---

<BaseLayout
  title={`${cat.title} Gallery`}
  description={`${cat.blurb} ${count} photos from Mod Labs in Seattle.`}
  breadcrumbs={[
    { name: "Gallery", path: "/gallery" },
    { name: cat.short, path: `/gallery/${cat.slug}` },
  ]}
>
  <PageHero title={cat.title} intro={`${cat.blurb} ${count} photos.`} compact />
  <GalleryView category={cat.slug} />
  <FinalCta title="Want yours on this page?" />
</BaseLayout>
