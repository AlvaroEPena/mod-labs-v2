---
/** Terms (spec §16 phase 2): compact hero → long-form doc with a scrollspy table of contents. Copy unchanged. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import LegalDoc, { type LegalSection } from "../components/legal/LegalDoc.astro";

const sections: LegalSection[] = [
  {
    id: "services",
    title: "Services",
    html: `<p>Mod Labs provides console modding, repair and custom build services as described on this site. Prices on the Services and Builds pages are informational until confirmed with you after I've seen the device or discussed the build. Complex damage, prior rework or missing parts may change the scope and cost, and I'll always check with you before going ahead.</p>`,
  },
  {
    id: "requests",
    title: "Requests aren't bookings yet",
    html: `<p>Sending a booking or quote request doesn't commit either of us. A job is confirmed once we've agreed on the price, timing and how the device gets to me.</p>`,
  },
  {
    id: "commissions",
    title: "Custom build commissions",
    html: `<p>Commission builds are made to order by hand. The timeline, final spec and payment details are agreed with you before work starts.</p>`,
  },
  {
    id: "shipping",
    title: "Shipping & risk",
    html: `<p>For mail-in work, you're responsible for packing and insuring your shipment to me. Risk of loss in transit rests with the carrier and any insurance you choose, unless we agree otherwise in writing.</p>`,
  },
  {
    id: "warranty",
    title: "Warranty",
    html: `<p>Any workmanship coverage is confirmed with your completed job. Physical damage, abuse or changes made by others after pickup aren't covered.</p>`,
  },
  {
    id: "responsibilities",
    title: "Your responsibilities",
    html: `<p>You confirm you own the device (or have permission to have it worked on) and that you'll use it lawfully. Modding a console can affect manufacturer warranties and online-service access. I'll explain the trade-offs, and the decision is yours.</p>`,
  },
  {
    id: "liability",
    title: "Limitation of liability",
    html: `<p>To the extent permitted by law, Mod Labs' liability is limited to the amount you paid for the specific service giving rise to the claim. Advanced board work carries some inherent risk, which you accept by proceeding.</p>`,
  },
  {
    id: "questions",
    title: "Questions",
    html: `<p>Anything unclear? <a href="/quote">Send me a message</a> before booking and I'll explain.</p>`,
  },
];
---

<BaseLayout
  title="Terms"
  description="Terms for using the Mod Labs website and requesting console modding, repair or custom build work."
  breadcrumbs={[{ name: "Terms", path: "/terms" }]}
>
  <PageHero title="Terms" intro="The ground rules for working together, kept short and readable." compact />
  <LegalDoc sections={sections} updated="September 2026" />
</BaseLayout>
