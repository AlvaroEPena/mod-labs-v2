---
/**
 * Reviews (spec §17). Job: read real reviews, and write one. Static HTML is the empty state; the Worker
 * injects every approved review into [data-reviews-slot="all"], sets [data-reviews-summary] and flips the
 * when-empty / when-any blocks. Layout: split hero with a state-aware summary card → masonry wall of
 * reviews (only when there are any) → write section: how reviews work beside the form (#write).
 * The phone CTA pill is off here, like on the other form pages.
 */
import "../styles/reviews.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import ReviewForm from "../components/forms/ReviewForm.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../components/ui/icons";

/** `note`: a quieter follow-up line under the body (the moderation policy, so visitors know reviews aren't cherry-picked). */
const howItWorks: { icon: IconName; title: string; body: string; note?: string }[] = [
  { icon: "pencil", title: "Anyone I've worked for can write one", body: "Mods, repairs or a commission build. A few honest sentences is plenty." },
  {
    icon: "seal-check",
    title: "I check every review first",
    body: "Nothing goes live until I've approved it, which keeps spam off the page.",
    // FTC rule on review suppression: say plainly that negative reviews are published too. Owner to confirm wording.
    note: "I publish every genuine review, good or bad. I only remove spam, abuse or private details.",
  },
  { icon: "shield", title: "No email, no account", body: "Just your name and your words. Links aren't allowed in reviews." },
];
---

<BaseLayout
  title="Reviews"
  description="Customer reviews of Mod Labs console modding and repair in Seattle, and a quick form to leave your own after your mod or repair."
  ctaBar={false}
  breadcrumbs={[{ name: "Reviews", path: "/reviews" }]}
>
  <PageHero
    title="Had work done? Say how it went."
    highlight="Say how it went."
    intro="Reviews are written by customers and go live once I've checked them, so the page stays spam-free."
  >
    <div class="score glass-flat" slot="aside">
      <div data-reviews-when-any hidden>
        {/* one star as a symbol next to the real average: five lit stars would claim a rating the reviews may not have */}
        <p class="score-text">
          <Icon name="star-fill" size={24} class="score-star" />
          <span data-reviews-summary>Approved customer reviews</span>
        </p>
        <p class="mt-1 text-sm text-muted">Every one checked by me before it went live.</p>
      </div>
      <div data-reviews-when-empty>
        <span class="score-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={26} />)}</span>
        <p class="score-text">No reviews yet</p>
        <p class="mt-1 text-sm leading-relaxed text-muted">Had a console modded or repaired here? Yours could be the first.</p>
      </div>
      <a href="#write" class="btn btn-primary mt-6 w-full">Write a review <Icon name="pencil" size={16} /></a>
    </div>
  </PageHero>

  <section class="pb-16 sm:pb-24" aria-labelledby="all-reviews-title" data-reviews-when-any hidden>
    <div class="container-x">
      <h2 id="all-reviews-title" class="sr-only">All reviews</h2>
      <ul class="review-list is-wall" data-reviews-slot="all"></ul>
    </div>
  </section>

  <section id="write" class="write section-y ambient scroll-mt-20" aria-labelledby="write-title">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <h2 id="write-title" class="text-4xl sm:text-5xl">Write a review</h2>
        <ul class="mt-8 grid gap-6">
          {
            howItWorks.map((h) => (
              <li class="flex gap-4">
                <span class="icon-pad" aria-hidden="true">
                  <Icon name={h.icon} size={22} />
                </span>
                <span>
                  <span class="block font-semibold text-fg">{h.title}</span>
                  <span class="mt-1 block leading-relaxed text-muted">{h.body}</span>
                  {h.note && <span class="mt-2 block text-sm leading-relaxed text-pretty text-dim">{h.note}</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card p-5 sm:p-9 lg:col-span-7">
        <ReviewForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .score {
    width: 100%;
    max-width: 24rem;
    margin-inline: auto;
    padding: 1.75rem;
    border-radius: var(--radius-card);
  }
  @media (width >= 64rem) {
    .score {
      margin-inline: auto 0;
      padding: 2rem;
    }
  }
  /* empty state: five unlit outlines, an invitation rather than a score */
  .score-stars {
    display: flex;
    gap: 0.25rem;
    color: rgb(78 224 239 / 0.5);
  }
  .score-text {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
  }
  .score-stars + .score-text {
    margin-top: 1rem;
  }
  /* centred on the first line of the summary, which may wrap */
  .score-text :global(.score-star) {
    flex: none;
    margin-top: 0.1em;
    color: var(--color-cyan);
    filter: drop-shadow(0 0 8px rgb(78 224 239 / 0.45));
  }
  /* the full wall: a masonry of reviews (1 / 2 / 3 columns) */
  .is-wall {
    display: block;
    columns: 1;
    column-gap: 1rem;
  }
  .is-wall > :global(.review-card) {
    margin-bottom: 1rem;
  }
  @media (width >= 48rem) {
    .is-wall {
      columns: 2;
    }
  }
  @media (width >= 80rem) {
    .is-wall {
      columns: 3;
    }
  }
  .write {
    --ax: 72%;
    --ay: 45%;
  }
</style>
