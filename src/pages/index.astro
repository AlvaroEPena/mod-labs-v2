---
/**
 * Home (spec §16): hero → pricing bento → how it works → commission builds → gallery rail →
 * why Mod Labs → (real reviews, when any exist) → FAQ → closing CTA with socials.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import PricingBento from "../components/home/PricingBento.astro";
import Steps from "../components/home/Steps.astro";
import BuildsShowcase from "../components/home/BuildsShowcase.astro";
import GalleryRail from "../components/home/GalleryRail.astro";
import TrustSplit from "../components/home/TrustSplit.astro";
import Reviews from "../components/home/Reviews.astro";
import FaqList from "../components/ui/FaqList.astro";
import FinalCta from "../components/ui/FinalCta.astro";
import Icon from "../components/ui/Icon.astro";
import { localBusinessLd } from "../components/layout/seo";
import { faqs } from "../data/faq";
import { site } from "../data/site";

const homeFaqs = faqs.filter((f) => f.home);
const siteUrl = (Astro.site?.toString() ?? site.url).replace(/\/$/, "");
---

<BaseLayout description={site.description} jsonLd={[localBusinessLd(siteUrl)]}>
  <Hero />
  <PricingBento />
  <Steps />
  <BuildsShowcase />
  <GalleryRail />
  <TrustSplit />
  <Reviews />

  <section class="section-y" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h2 id="faq-title" class="reveal text-4xl sm:text-5xl">Questions? Good.</h2>
        <p class="lead reveal mt-5 max-w-sm">The ones I hear most. Anything else, just ask.</p>
        <a href="/faq" class="link-arrow reveal mt-6">All questions <Icon name="arrow" size={18} /></a>
      </div>
      <div class="card reveal px-6 py-2 sm:px-8 lg:col-span-8">
        <FaqList items={homeFaqs} />
      </div>
    </div>
  </section>

  <FinalCta socials />
</BaseLayout>
