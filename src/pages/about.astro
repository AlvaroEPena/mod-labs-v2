---
/**
 * About (spec §16 phase 2). Job: put a person behind the bench and earn trust. Layout families: split hero
 * with dealt photo prints → story with a sticky pull quote and a toolkit → scroll-drawn origin trace
 * (interactive storytelling) → asymmetric principles pair with a drop-off/mail-in strip → CTA slab.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import PhotoStack from "../components/about/PhotoStack.astro";
import OriginTrace from "../components/about/OriginTrace.astro";
import FinalCta from "../components/ui/FinalCta.astro";
import Icon from "../components/ui/Icon.astro";
import { site } from "../data/site";

const toolkit = ["Soldering", "PCB rework", "Component-level diagnostics", "Wiring", "System-level troubleshooting"];
---

<BaseLayout
  title="About Alvaro"
  description="Meet Alvaro, the hardware modder and electronics tech behind Mod Labs in Seattle: 9+ years of repair, micro-soldering and custom builds, with local drop-off and mail-in."
  breadcrumbs={[{ name: "About", path: "/about" }]}
>
  <PageHero
    title="Hi, I'm Alvaro. This is my lab."
    highlight="my lab."
    intro="Mod Labs is a one-person, mod-first shop in Seattle, with room for repair work when a board needs help beyond the usual install."
  >
    <PhotoStack slot="aside" />
  </PageHero>

  <section class="section-y" aria-labelledby="story-title">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 id="story-title" class="reveal max-w-xl text-4xl sm:text-5xl">A lifelong tinkerer, doing the job right.</h2>
        <div class="prose-lab reveal mt-7 text-[1.06rem]">
          <p>
            I'm a hardware modder, electronics tech and lifelong tinkerer based in {site.location.city}. Whether it's a simple fix or a
            full custom mod, I focus on doing the job right, with transparency and craftsmanship you can trust.
          </p>
          <p>You'll always know what I'm doing to your console and why. These are the skills behind every job:</p>
        </div>
        <ul class="reveal-stagger mt-6 flex flex-wrap gap-2" aria-label="Skills">
          {toolkit.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </div>
      <figure class="quote glass reveal lg:col-span-5">
        <Icon name="quotes" size={34} class="text-cyan" />
        <blockquote class="mt-4">
          <p>If it has wires, chips or moving parts, I can probably fix it, improve it or make it cooler.</p>
        </blockquote>
        <figcaption class="mt-6 text-sm text-muted">{site.owner}, Mod Labs</figcaption>
      </figure>
    </div>
  </section>

  <OriginTrace />

  <section class="section-y" aria-labelledby="work-title">
    <div class="container-x">
      <h2 id="work-title" class="reveal max-w-2xl text-4xl sm:text-5xl">How I treat your console.</h2>
      <div class="reveal-stagger mt-12 grid gap-4 lg:grid-cols-12">
        <div class="note-lead card glow-edge p-7 sm:p-9 lg:col-span-7">
          <span class="icon-pad" aria-hidden="true"><Icon name="hand" size={22} /></span>
          <h3 class="mt-5 text-2xl">Like it's staying in my own collection</h3>
          <p class="mt-3 leading-relaxed text-muted">
            Clean flux habits, careful torque on screws, strain relief on flex cables, and a full test before it goes back to you. Everything
            is personalized and noob-friendly. Questions are always welcome, and I'll keep you posted on progress.
          </p>
        </div>
        <div class="card glow-edge p-7 sm:p-9 lg:col-span-5">
          <span class="icon-pad" aria-hidden="true"><Icon name="shield" size={22} /></span>
          <h3 class="mt-5 text-2xl">Your devices and data</h3>
          <p class="mt-3 leading-relaxed text-muted">
            Your device may hold personal data, so back up anything important before dropping it off or shipping it. Storage isn't wiped
            for typical mod installs unless you ask. If a device turns out to be unrepairable, I'll contact you with next steps.
          </p>
        </div>
        <a href="/services#delivery" class="strip card glow-edge lg:col-span-12">
          <span class="strip-item">
            <Icon name="pin" size={20} class="shrink-0 text-cyan" />
            <span>{site.serviceArea.local}</span>
          </span>
          <span class="strip-item">
            <Icon name="truck" size={20} class="shrink-0 text-cyan" />
            <span>{site.serviceArea.mailIn}</span>
          </span>
          <span class="strip-go">How drop-off and mail-in work <Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
  </section>

  <FinalCta title="Got a project in mind?" body="Tell me about it. Mods, repairs or something that's never been built before, I'm happy to talk it through." />
</BaseLayout>

<style>
  .quote {
    align-self: start;
    padding: 2rem;
    border-radius: var(--radius-card);
  }
  @media (width >= 64rem) {
    .quote {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      margin-top: 0.5rem;
      padding: 2.5rem;
    }
  }
  .quote blockquote p {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .note-lead {
    background:
      radial-gradient(28rem 16rem at 0% 0%, rgb(78 224 239 / 0.1), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.055), rgb(255 255 255 / 0.015) 60%),
      rgb(12 17 31 / 0.64);
  }
  .strip {
    display: grid;
    gap: 1rem;
    padding: 1.4rem 1.6rem;
    text-decoration: none;
    color: var(--color-muted);
  }
  @media (width >= 64rem) {
    .strip {
      grid-template-columns: 1fr 1fr auto;
      align-items: center;
      gap: 2rem;
      padding: 1.5rem 2rem;
    }
  }
  .strip-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    line-height: 1.5;
  }
  .strip-go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--color-cyan-soft);
    white-space: nowrap;
  }
  .strip:hover .strip-go {
    color: var(--color-cyan);
  }
</style>
