---
/**
 * Custom build commissions (spec §16 phase 2). Job: show two one-off consoles like products and turn
 * interest into a commission request. Layout families: split hero with two offset product cards →
 * per build: carousel + sticky glass info (mirrored for the second), spec explorer (interactive),
 * packing slip → CTA slab.
 */
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import BuildPicker from "../components/builds/BuildPicker.astro";
import BuildSection from "../components/builds/BuildSection.astro";
import FinalCta from "../components/ui/FinalCta.astro";
import { buildCover } from "../components/media/picks";
import { buildsLd } from "../components/layout/seo";
import { builds } from "../data/builds";
import { site } from "../data/site";

const siteUrl = (Astro.site?.toString() ?? site.url).replace(/\/$/, "");
/** absolute product image per build for the Product JSON-LD */
const productImages = Object.fromEntries(
  await Promise.all(
    builds.map(async (b) => {
      const { image } = buildCover(b.slug);
      const img = await getImage({ src: image, width: 1200, format: "webp", quality: 72 });
      return [b.slug, `${siteUrl}${img.src}`] as const;
    }),
  ),
);
const [first, second] = builds;
---

<BaseLayout
  title="Custom Builds: GWii & Wii Miicro"
  description={`Commission a hand-built console: the ${first.name} ($${first.price}) or the ${second.name} ($${second.price}). Real Wii hardware, no emulation, built in Seattle.`}
  jsonLd={[buildsLd(siteUrl, builds, productImages)]}
  breadcrumbs={[{ name: "Custom builds", path: "/builds" }]}
>
  <PageHero
    title="One-off consoles, built by hand."
    highlight="built by hand."
    intro="Real Wii motherboards, trimmed, relocated and tuned into consoles you can't buy anywhere else. Each one is made to order."
  >
    <BuildPicker slot="aside" />
  </PageHero>

  {builds.map((b, i) => <BuildSection build={b} flip={i % 2 === 1} />)}

  <FinalCta
    title="Have your own build in mind?"
    body="Portables, shrunken consoles, RGB shells: if you can describe it, I'll tell you honestly whether it's doable and what it would take."
  />
</BaseLayout>
