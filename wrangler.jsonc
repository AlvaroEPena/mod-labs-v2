{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seattle",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-24",
  // nodejs_compat provides a global Buffer (fast base64 for photo attachments)
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /api/* plus the pages that show reviews (the Worker injects approved reviews with HTMLRewriter).
    // Keep the page entries in sync with REVIEW_PAGE_PATHS in worker/reviews/publish.ts.
    "run_worker_first": ["/api/*", "/", "/index.html", "/reviews", "/reviews.html"]
  },
  // Reviews (spec §17): the production database, created 2026-11-05. Apply migrations/ to it with
  // `npm run db:migrate:remote` before pushing code that needs them.
  // Local `wrangler dev` / `--local` commands use local D1 state under .wrangler/ and work as is.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mod-labs-reviews",
      "database_id": "135788ab-aad5-4cef-b423-608c17769540",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret config. Secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY, LEAD_EMAIL_TO, REVIEW_SIGNING_KEY) go in
  // .dev.vars locally and `npx wrangler secret put <NAME>` in production.
  // Optional: EMAIL_FROM (e.g. "Mod Labs <leads@yourdomain.com>") once a domain is verified in Resend.
  "vars": {
    "EMAIL_MODE": "send"
  },
  // Workers Rate Limiting bindings, per client IP and per Cloudflare location; the Worker falls back to a
  // best-effort in-memory limiter if a binding is missing. Keep the numbers in sync with worker/lib/ratelimit.ts.
  //  - FORM_RATE_LIMITER: 5 book/quote submissions / 60 s
  //  - REVIEW_RATE_LIMITER: 2 review submissions / 60 s (the binding only allows 10 s or 60 s periods;
  //    the D1-backed daily limits in worker/reviews/ bound the rest: 3 per visitor per UTC day, 20 site-wide / 24 h)
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REVIEW_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  // Custom domain, kept in code so every deploy re-asserts it. www.modlabs.store is a proxied DNS record
  // + a zone Redirect Rule (www → root, 301, query string kept), configured in the dashboard.
  // The seattle.thecorvis.workers.dev URL stays enabled as a fallback.
  "routes": [{ "pattern": "modlabs.store", "custom_domain": true }],
  "observability": { "enabled": true }
}
