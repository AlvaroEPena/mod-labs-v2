# Security + caching headers for static assets (Cloudflare Workers static assets).
# Worker-generated /api/* responses set their own headers in worker/lib/http.ts. The Worker-first pages
# (/ and /reviews) get these too: they come from env.ASSETS.fetch(), which applies this file.
# script-src: `npm run build` (scripts/csp-hashes.mjs) appends a sha256 hash for every inline script to the
# copy in dist/_headers. 'unsafe-inline' is only the CSP1 fallback (ignored once a hash is present).
# Cloudflare limits each line to 2,000 characters; the build fails before that.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; media-src 'self'; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=2592000
