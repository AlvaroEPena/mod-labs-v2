# PUBLIC build-time values for production (committed on purpose: Cloudflare Workers Builds
# builds from GitHub and can't see local .env files). These values are shown to every visitor anyway.
# NEVER put secrets here. Secrets go in `npx wrangler secret put <NAME>` (see README).
PUBLIC_SITE_URL=https://modlabs.store
# Turnstile SITE key (public) from Cloudflare → Turnstile → your widget
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFDIBJQH9mP5KNZ9
