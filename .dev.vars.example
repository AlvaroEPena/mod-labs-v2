# Worker secrets/vars for local `wrangler dev` (copy to .dev.vars; values here override wrangler.jsonc "vars").
# In production use: npx wrangler secret put <NAME>
# Cloudflare's official always-pass TEST secret (use 2x0000000000000000000000000000000AA to test failures):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# From https://resend.com/api-keys — only needed when EMAIL_MODE=send
RESEND_API_KEY=
# Inbox that receives booking/quote requests (must be the Resend account email until a domain is verified)
LEAD_EMAIL_TO=
# "log" = print a summary of each email to the console and return success. Only honoured for requests to
#   localhost/127.0.0.1; on any other host the Worker behaves as "send" (never fake success in production).
# "send" (production default from wrangler.jsonc) = deliver via Resend; missing key/inbox → 503 not_configured.
#   In send mode a Cloudflare TEST Turnstile secret (1x0000…/2x0000…/3x0000…) is refused with not_configured.
EMAIL_MODE=log
# Optional sender override once a domain is verified in Resend (default: Mod Labs <onboarding@resend.dev>)
# EMAIL_FROM=Mod Labs <leads@example.com>
