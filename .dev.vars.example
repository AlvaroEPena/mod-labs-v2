# Worker secrets for local `wrangler dev` (copy to .dev.vars). In production use: npx wrangler secret put <NAME>
# Cloudflare's official always-pass TEST secret:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# From https://resend.com/api-keys — leave empty in dev to log emails instead of sending
RESEND_API_KEY=
# Inbox that receives booking/quote requests (must be the Resend account email until a domain is verified)
LEAD_EMAIL_TO=
# "log" = print emails to the console instead of sending (local dev / tests). Production uses "send".
EMAIL_MODE=log
